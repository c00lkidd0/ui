function tabHandler:Section(sectionTitle, side)
	local section = setmetatable({}, sectionHandler)
	local sectionInstance = original_elements.Section:Clone()
	local isMaximized = true
	local resizeMinTween = tweenservice:Create(sectionInstance.Heading.ResizeButton, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Rotation = 180 })
	local resizeMaxTween = tweenservice:Create(sectionInstance.Heading.ResizeButton, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Rotation = 0 })

	local function get_needed_height()
		local holder = sectionInstance.ElementHolder
		local pad = holder.ElementHolderPadding
		local content_y = holder.ElementHolderList.AbsoluteContentSize.Y + pad.PaddingBottom.Offset + pad.PaddingTop.Offset
		return math.max(M.SectionHead + 12, sectionInstance.Heading.Size.Y.Offset + content_y)
	end

	local function get_target_column()
		if side and type(side) == "string" then
			local s = side:lower()
			if s == "left" then return self.ElementToParentChildren.LeftScrollingFrame end
			if s == "right" then return self.ElementToParentChildren.RightScrollingFrame end
		end
		local best_sf = self.ElementToParentChildren.LeftScrollingFrame
		local best_y = math.huge
		for _, sf in ipairs(self.ElementToParentChildren:GetChildren()) do
			if sf:IsA("ScrollingFrame") then
				local list = sf:FindFirstChildWhichIsA("UIListLayout")
				if list and list.AbsoluteContentSize.Y < best_y then
					best_sf = sf
					best_y = list.AbsoluteContentSize.Y
				end
			end
		end
		return best_sf
	end

	local function on_resize_click()
		if isMaximized then
			isMaximized = false
			sectionInstance.Heading.HeadingSeperator.Visible = false
			resizeMinTween:Play()
			tweenservice:Create(sectionInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(1, 0, 0, sectionInstance.Heading.Size.Y.Offset)
			}):Play()
		else
			isMaximized = true
			sectionInstance.Heading.HeadingSeperator.Visible = true
			resizeMaxTween:Play()
			tweenservice:Create(sectionInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(1, 0, 0, get_needed_height())
			}):Play()
		end
	end

	section.Type = "Section"
	section.IdentifierText = sectionTitle or "N/A"
	section.Instance = sectionInstance
	section.GuiToRemove = sectionInstance
	section.ElementToParentChildren = sectionInstance.ElementHolder

	sectionInstance.Heading.ResizeButton.Activated:Connect(on_resize_click)

	local resizeQueued = false
	local function apply_section_size()
		if not isMaximized then return end
		local holder = sectionInstance.ElementHolder
		local pad = holder.ElementHolderPadding
		local content_y = holder.ElementHolderList.AbsoluteContentSize.Y + pad.PaddingBottom.Offset + pad.PaddingTop.Offset
		local new_sec_y = get_needed_height()
		local new_hold_y = math.max(12, content_y)

		if sectionInstance.Size.Y.Offset ~= new_sec_y then
			sectionInstance.Size = UDim2.new(1, 0, 0, new_sec_y)
		end
		if holder.Size.Y.Offset ~= new_hold_y then
			holder.Size = UDim2.new(1, 0, 0, new_hold_y)
		end
	end

	local function queue_section_resize()
		if resizeQueued then return end
		resizeQueued = true
		task.defer(function()
			resizeQueued = false
			if sectionInstance.Parent then apply_section_size() end
		end)
	end

	sectionInstance.ElementHolder.ElementHolderList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(queue_section_resize)
