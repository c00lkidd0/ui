local function resolve_tab_icon(tab_name, icon_id)
	if icon_id and icon_id ~= "" and icon_id ~= "rbxassetid://10746039695" and icon_id ~= "rbxassetid://11436779516" then
		if tostring(icon_id):match("^%d+$") then
			return "rbxassetid://" .. tostring(icon_id)
		end
		return icon_id
	end
	local lower = tostring(tab_name or ""):lower()
	if lower:find("rage") or lower:find("aim") or lower:find("combat") or lower:find("weapon") or lower:find("gun") or lower:find("main") then
		return ICONS.Aim
	elseif lower:find("legit") or lower:find("safe") or lower:find("def") or lower:find("guard") or lower:find("player") then
		return ICONS.Shield
	elseif lower:find("move") or lower:find("speed") or lower:find("fly") or lower:find("tele") then
		return ICONS.Movement
	elseif lower:find("vis") or lower:find("esp") or lower:find("render") or lower:find("world") or lower:find("cham") then
		return ICONS.Visuals
	elseif lower:find("skin") or lower:find("cosmetic") or lower:find("knife") or lower:find("glove") or lower:find("changer") then
		return ICONS.Cosmetics
	elseif lower:find("cfg") or lower:find("config") or lower:find("set") or lower:find("misc") or lower:find("hud") then
		return ICONS.Config
	end
	return icon_id or ICONS.Aim
end

