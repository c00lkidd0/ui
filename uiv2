local function deep_copy_table(t)
	if type(t) ~= "table" then return t end
	local out = {}
	for k, v in pairs(t) do
		out[k] = type(v) == "table" and deep_copy_table(v) or v
	end
	return out
end

local function read_flag_val(flag)
	if not flag then return nil end
	if genv[flag] ~= nil then return genv[flag] end
	if _G[flag] ~= nil then return _G[flag] end
	return nil
end

local function capture_default_flag(flag)
	if not flag or flag == "" then return end
	synced_flags[flag] = true
	if default_flag_values[flag] ~= nil then return end
	local v = read_flag_val(flag)
	if v ~= nil then
		default_flag_values[flag] = type(v) == "table" and deep_copy_table(v) or v
	end
end

local function is_syncable_val(v)
	local tv = typeof(v)
	return tv == "boolean" or tv == "number" or tv == "string" or tv == "Color3"
end

local function infer_flag_from_cb(cb)
	if type(cb) ~= "function" then return nil end
	local gc = (debug and debug.getconstants) or getconstants
	if not gc then return nil end
	local ok, consts = pcall(gc, cb)
	if not ok or type(consts) ~= "table" then return nil end
	for _, c in pairs(consts) do
		if type(c) == "string" and c ~= "" and c ~= "G" and c ~= "_G" and c ~= "getgenv" then
			local v = read_flag_val(c)
			if v ~= nil and is_syncable_val(v) then
				capture_default_flag(c)
				return c
			end
		end
	end
	return nil
end

local function resolve_sync_flag(explicit_flag, label_name, cb)
	if explicit_flag and explicit_flag ~= "" then
		capture_default_flag(explicit_flag)
		return explicit_flag
	end
	local from_cb = infer_flag_from_cb(cb)
	if from_cb then
		capture_default_flag(from_cb)
		return from_cb
	end
	local fallback = explicit_flag or label_name
	if fallback and read_flag_val(fallback) ~= nil then
		capture_default_flag(fallback)
	end
	return fallback
end

local function write_flag_val(flag, val)
	if not flag then return end
	capture_default_flag(flag)
	genv[flag] = val
	_G[flag] = val
	local w = genv_watchers[flag]
	if w then w.last = val end
end

local function start_genv_watch()
	if genv_watch_started then return end
	genv_watch_started = true
	task.spawn(function()
		while library_alive do
			local any = false
			for flag, w in pairs(genv_watchers) do
				any = true
				local v = read_flag_val(flag)
				if v ~= nil and v ~= w.last and not (w.busy and w.busy()) then
					w.last = v
					restore_id()
					for _, cb in ipairs(w.callbacks) do
						pcall(cb, v)
					end
					w.last = read_flag_val(flag)
				end
			end
			if not any then break end
			task.wait(0.04)
		end
		genv_watch_started = false
	end)
end

local function watch_genv(flag, apply, busy)
	if not flag then return end
	capture_default_flag(flag)
	local existing = genv_watchers[flag]
	if existing then
		table.insert(existing.callbacks, apply)
		if busy then
			local prev_busy = existing.busy
			existing.busy = function() return (prev_busy and prev_busy()) or busy() end
		end
	else
		genv_watchers[flag] = {
			last = read_flag_val(flag),
			callbacks = { apply },
			busy = busy,
		}
	end
	start_genv_watch()
end

local is_mobile = uis.TouchEnabled and (not uis.MouseEnabled or cam.ViewportSize.Y <= 680)
local vp_size = cam.ViewportSize

local function compute_auto_scale()
	local vp = cam.ViewportSize
	if is_mobile then
		return math.clamp(math.min(vp.X / 820, vp.Y / 430), 0.78, 1.0)
	end
	return math.clamp(math.min(vp.X / 1360, vp.Y / 820), 0.82, 1.22)
end

local scale_factor = compute_auto_scale()
local ui_scale_instances = {}

local function update_all_ui_scales()
	local auto_on = _G.BSMTConfigData and _G.BSMTConfigData["ui_auto_scale"]
	if auto_on == nil then auto_on = true end
	local base = auto_on and compute_auto_scale() or 1.0
	local pct = (_G.BSMTConfigData and tonumber(_G.BSMTConfigData["ui_scale_pct"])) or 100
	scale_factor = math.clamp(base * (pct / 100), 0.65, 1.45)
	if Library and Library.Settings then
		Library.Settings.ScaleFactor = scale_factor
	end
	for sc in pairs(ui_scale_instances) do
		if sc and sc.Parent then
			sc.Scale = scale_factor
		else
			ui_scale_instances[sc] = nil
		end
	end
end

local function attach_ui_scale(inst)
	local sc = Instance.new("UIScale")
	sc.Name = "BSMTUIScale"
	sc.Scale = scale_factor
	sc.Parent = inst
	ui_scale_instances[sc] = true
	return sc
end

local function set_scroll_lock(inst, locked)
	if not inst then return end
	local cur = inst.Parent
	while cur do
		if cur:IsA("ScrollingFrame") then
			cur.ScrollingEnabled = not locked
		end
		cur = cur.Parent
	end
end

local BINDABLE_MOUSE_TYPES = {
	[Enum.UserInputType.MouseButton1] = "MB1",
	[Enum.UserInputType.MouseButton2] = "MB2",
	[Enum.UserInputType.MouseButton3] = "MB3",
}

local MOUSE_DISPLAY = {
	MB1 = "LClick", MB2 = "RClick", MB3 = "M3",
}

local function resolve_binding(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.Unknown then return nil, nil end
		return input.KeyCode.Name, { kind = "Key", keyCode = input.KeyCode }
	end
	local mb_name = BINDABLE_MOUSE_TYPES[input.UserInputType]
	if mb_name then
		return MOUSE_DISPLAY[mb_name] or mb_name, { kind = "Mouse", inputType = input.UserInputType }
	end
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		local dir = input.Position.Z > 0 and 1 or -1
		local disp = dir > 0 and "ScrlUp" or "ScrlDn"
		return disp, { kind = "Scroll", direction = dir }
	end
	return nil, nil
end

local function binding_matches(input, binding)
	if not binding then return false end
	if binding.kind == "Key" then
		return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == binding.keyCode
	elseif binding.kind == "Mouse" then
		return input.UserInputType == binding.inputType
	elseif binding.kind == "Scroll" then
		return input.UserInputType == Enum.UserInputType.MouseWheel and ((input.Position.Z > 0) == (binding.direction > 0))
	end
	return false
end

local keybind_registry = {}
local keybind_dispatch = nil

local function ensure_keybind_dispatch()
	if keybind_dispatch then return end
	keybind_dispatch = track_conn(uis.InputBegan:Connect(function(input, gp)
		if gp then return end
		for entry in pairs(keybind_registry) do
			if not entry.isListening() and binding_matches(input, entry.getBinding()) then
				task.spawn(entry.callback)
			end
		end
	end))
end

local function register_keybind(entry)
	keybind_registry[entry] = true
	ensure_keybind_dispatch()
	return entry
end

local function unregister_keybind(entry)
	if entry then keybind_registry[entry] = nil end
end

local function encode_binding(binding)
	if not binding then return "" end
	if binding.kind == "Key" then return "Key:" .. binding.keyCode.Name end
	if binding.kind == "Mouse" then return "Mouse:" .. binding.inputType.Name end
	if binding.kind == "Scroll" then return "Scroll:" .. tostring(binding.direction) end
	return ""
end

local function decode_binding(str)
	if not str or str == "" then return nil, nil end
	local kind, val = str:match("^(%a+):(.+)$")
	if kind == "Key" then
		for _, kc in pairs(Enum.KeyCode:GetEnumItems()) do
			if kc.Name == val then
				return kc.Name, { kind = "Key", keyCode = kc }
			end
		end
	elseif kind == "Mouse" then
		for ut, name in pairs(BINDABLE_MOUSE_TYPES) do
			if ut.Name == val then
				return MOUSE_DISPLAY[name] or name, { kind = "Mouse", inputType = ut }
			end
		end
	elseif kind == "Scroll" then
		local d = tonumber(val)
		if d then
			return (d > 0 and "ScrlUp" or "ScrlDn"), { kind = "Scroll", direction = d }
		end
	end
	for _, kc in pairs(Enum.KeyCode:GetEnumItems()) do
		if kc.Name:lower() == tostring(str):lower() then
			return kc.Name, { kind = "Key", keyCode = kc }
		end
	end
	return nil, nil
end

