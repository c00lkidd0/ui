function elementHandler:ColorWheel(colorWheelName, callback, flag)
	restore_id()
	local colorWheel = setmetatable({}, colorWheelHandler)
	local colorWheelInstance = original_elements.ColorWheel:Clone()
	local draggingWheel = false
	local draggingSlider = false

	local heading = colorWheelInstance.Heading
	local swatch = heading.Swatch
	local wheelHolder = colorWheelInstance.WheelHolder
	local valueHolder = wheelHolder.ValueHolder
	local colorInputHolder = valueHolder.ColorInputHolder
	local wheel = wheelHolder.Wheel
	local selector = wheel.Selector
	local slider = valueHolder.ValueSlider
	local sliderBar = slider.SliderBar
	local wheelRadius = 49

	local dropdownOpenTween = tweenservice:Create(colorWheelInstance, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, M.ElementH + 106) })
	local dropdownCloseTween = tweenservice:Create(colorWheelInstance, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, M.ElementH) })

	local hue, saturation, value = 0, 0, 1
	colorWheelName = colorWheelName or "Color"
	callback = callback or function() end
	local syncKey = resolve_sync_flag(flag, colorWheelName, callback) or colorWheelName

	local function update_visuals(fireCb)
		local color = Color3.fromHSV(hue, saturation, value)
		colorWheel._currentColor = color
		valueHolder.ColorSample.BackgroundColor3 = color
		swatch.BackgroundColor3 = color
		colorInputHolder.Red.BoxBackground.InnerBox.ColorValue.Text = tostring(math.round(color.R * 255))
		colorInputHolder.Green.BoxBackground.InnerBox.ColorValue.Text = tostring(math.round(color.G * 255))
		colorInputHolder.Blue.BoxBackground.InnerBox.ColorValue.Text = tostring(math.round(color.B * 255))
		write_flag_val(syncKey, color)
		_G.BSMTConfigData[colorWheel.ConfigIdentifier] = { math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255) }
		if fireCb ~= false then callback(color) end
	end

	local function set_color_visual_positions()
		local wSize = wheel.AbsoluteSize.X
		wheelRadius = (wSize > 10) and (wSize / 2) or 49
		local angle = math.rad(hue * 360 - 180)
		local rad = saturation * wheelRadius
		selector.Position = UDim2.new(0.5, rad * math.cos(angle), 0.5, -rad * math.sin(angle))
		sliderBar.Position = UDim2.new(math.clamp(value, 0, 1), 0, 0, 0)
	end

	local function set_color_from_c3(c3, fireCb)
		hue, saturation, value = c3:ToHSV()
		set_color_visual_positions()
		update_visuals(fireCb)
	end

	local function apply_slider_from_x(px)
		local sPos = slider.AbsolutePosition
		local sSize = slider.AbsoluteSize
		if sSize.X <= 0 then return end
		value = math.clamp((px - sPos.X) / sSize.X, 0, 1)
		sliderBar.Position = UDim2.new(value, 0, 0, 0)
		update_visuals(true)
	end

	local function apply_ring_from_xy(px, py)
		local wSize = wheel.AbsoluteSize.X
		wheelRadius = (wSize > 10) and (wSize / 2) or 49
		local rel = Vector2.new(px, py) - wheel.AbsolutePosition - wheel.AbsoluteSize / 2
		local radius, angle = to_polar(rel * Vector2.new(1, -1))
		if radius > wheelRadius then
			rel = rel.Unit * wheelRadius
			radius = wheelRadius
		end
		selector.Position = UDim2.new(0.5, rel.X, 0.5, rel.Y)
		hue, saturation = (math.deg(angle) + 180) / 360, radius / wheelRadius
		update_visuals(true)
	end

	heading.Activated:Connect(function()
		colorWheel.IsExpanded = not colorWheel.IsExpanded
		if colorWheel.IsExpanded then
			set_color_visual_positions()
			dropdownOpenTween:Play()
		else
			dropdownCloseTween:Play()
		end
	end)

	slider.InputBegan:Connect(function(inp)
		if is_primary_input(inp) then
			draggingSlider = true
			set_scroll_lock(colorWheelInstance, true)
			apply_slider_from_x(inp.Position.X)
		end
	end)

	wheel.InputBegan:Connect(function(inp)
		if is_primary_input(inp) then
			draggingWheel = true
			set_scroll_lock(colorWheelInstance, true)
			apply_ring_from_xy(inp.Position.X, inp.Position.Y)
		end
	end)

	track_conn(uis.InputChanged:Connect(function(inp)
		if is_move_input(inp) then
			if draggingSlider then apply_slider_from_x(inp.Position.X) end
			if draggingWheel then apply_ring_from_xy(inp.Position.X, inp.Position.Y) end
		end
	end))

	track_conn(uis.InputEnded:Connect(function(inp)
		if is_primary_input(inp) and (draggingSlider or draggingWheel) then
			draggingSlider = false
			draggingWheel = false
			set_scroll_lock(colorWheelInstance, false)
		end
	end))

	local function on_rgb_lost_focus(tb, channel)
		local cur = Color3.fromHSV(hue, saturation, value)
		local map = { Red = "R", Green = "G", Blue = "B" }
		local tag = map[channel]
		local n = tonumber(tb.Text)
		if not n then
			tb.Text = tostring(math.round(cur[tag] * 255))
			return
		end
		n = math.clamp(n, 0, 255)
		local r, g, b = cur.R * 255, cur.G * 255, cur.B * 255
		if tag == "R" then r = n elseif tag == "G" then g = n else b = n end
		set_color_from_c3(Color3.fromRGB(r, g, b), true)
	end

	colorWheel.Type = "ColorWheel"
	colorWheel.IdentifierText = colorWheelName
	colorWheel.IsExpanded = false
	colorWheel.Instance = colorWheelInstance
	colorWheel.GuiToRemove = colorWheelInstance
	colorWheel.Flag = syncKey
	colorWheel.ConfigIdentifier = syncKey
	colorWheel._currentColor = Color3.fromRGB(255, 255, 255)

	register_config_element(colorWheel.ConfigIdentifier, colorWheel)

	function colorWheel:SetColor(c3, fireCb)
		restore_id()
		local parsed = parse_color(c3)
		if parsed then set_color_from_c3(parsed, fireCb) end
	end

	if self.Type == "SearchBar" then
		self.ChildedElementsInfo[colorWheelInstance] = colorWheel
	end

	heading.ColorWheelName.Text = colorWheelName
	colorWheelInstance.Parent = self.ElementToParentChildren

	for _, rgbFrame in ipairs(valueHolder.ColorInputHolder:GetChildren()) do
		if rgbFrame:IsA("Frame") then
			local cv = rgbFrame.BoxBackground.InnerBox.ColorValue
			cv.FocusLost:Connect(function() on_rgb_lost_focus(cv, rgbFrame.Name) end)
		end
	end

	local initialColor = parse_color(read_flag_val(syncKey)) or parse_color(_G.BSMTConfigData[syncKey])
	if initialColor then
		set_color_from_c3(initialColor, false)
	end

	task.defer(function()
		local deferredColor = parse_color(read_flag_val(syncKey)) or initialColor
		if deferredColor then
			set_color_from_c3(deferredColor, false)
		else
			set_color_visual_positions()
		end
	end)

	watch_genv(syncKey, function(v)
		local c = parse_color(v)
		if c and c ~= colorWheel._currentColor then
			set_color_from_c3(c, false)
		end
	end, function() return draggingWheel or draggingSlider end)

	return colorWheel
end

