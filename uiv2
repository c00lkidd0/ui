		track.BackgroundColor3 = Theme.Track
		track.BorderSizePixel = 0
		track.ZIndex = 3

		local fill = Instance.new("Frame")
		fill.Name = "ProgressFill"
		fill.Parent = track
		fill.BackgroundColor3 = accentColor
		fill.BorderSizePixel = 0
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.ZIndex = 4

		return root, outerStroke, fill
	end

	local function get_target_pos(cardW, cardH, stackOffset)
		local isLeft = notifCornerMode:find("Left") ~= nil
		local isBottom = notifCornerMode:find("Bottom") ~= nil
		local xScale = isLeft and 0 or 1
		local xOff = isLeft and 14 or -(cardW + 14)
		local yScale = isBottom and 1 or 0
		local yOff = isBottom and -(stackOffset + cardH) or stackOffset
		return UDim2.new(xScale, xOff, yScale, yOff)
	end

	local function get_offscreen_pos(cardW, yScale, yOff)
		local isLeft = notifCornerMode:find("Left") ~= nil
		if isLeft then
			return UDim2.new(0, -(cardW + 24), yScale, yOff)
		else
			return UDim2.new(1, 24, yScale, yOff)
		end
	end

	local function reflow_notifications()
		local stackY = 14
		for i = #activeNotifications, 1, -1 do
			local notif = activeNotifications[i]
			if notif and notif.Instance and notif.Instance.Parent and not notif._dismissing then
				local sz = notif.Instance.Size
				local cw, ch = sz.X.Offset, sz.Y.Offset
				tweenservice:Create(notif.Instance, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Position = get_target_pos(cw, ch, stackY)
				}):Play()
				stackY += ch + 6
			end
		end
	end

	function Library.SetNotificationPosition(mode)
		if type(mode) == "string" and mode ~= "" then
			notifCornerMode = mode
			_G.BSMTConfigData["notif_position"] = mode
			reflow_notifications()
		end
	end

	function Library.Notification(messageOrOpts, notifType, duration, customTitle)
		restore_id()
		local message, nType, dur, titleOverride
		if type(messageOrOpts) == "table" then
			message = tostring(messageOrOpts.Text or messageOrOpts.Message or messageOrOpts.Content or "Notification")
			nType = tostring(messageOrOpts.Type or notifType or "info")
			dur = tonumber(messageOrOpts.Duration) or tonumber(duration) or 4
			titleOverride = messageOrOpts.Title or customTitle
		else
			message = tostring(messageOrOpts or "Notification")
			nType = tostring(notifType or "info")
			dur = tonumber(duration) or 4
			titleOverride = customTitle
		end
		dur = math.clamp(dur, 1, 20)

		while #activeNotifications >= maxVisibleNotifs do
			local oldest = activeNotifications[1]
			if oldest then oldest:Dismiss() else break end
			table.remove(activeNotifications, 1)
		end

		local notification = setmetatable({}, notificationHandler)
		ensure_notif_container()

		local palette = {
			success = { title = "Success", color = Color3.fromRGB(85, 205, 140) },
			error   = { title = "Error",   color = Color3.fromRGB(230, 85, 90) },
			warning = { title = "Warning", color = Color3.fromRGB(235, 180, 75) },
			info    = { title = "BSMT",    color = Theme.Accent },
		}
		local cfg = palette[nType:lower()] or palette.info
		local headerText = titleOverride or cfg.title

		local cardW = is_mobile and math.min(260, math.round(cam.ViewportSize.X * 0.76)) or 276
		local textParams = Instance.new("GetTextBoundsParams")
		textParams.Text = message
		textParams.Font = Font.fromEnum(Enum.Font.Gotham)
		textParams.Size = 12
		textParams.Width = math.max(110, cardW - 26)
		local okBounds, bounds = pcall(function() return textservice:GetTextBoundsAsync(textParams) end)
		local textH = (okBounds and bounds and bounds.Y) or 16
		local cardH = math.clamp(textH + 36, 52, 124)

		local inst, outerStroke, fill = build_notif_frame(cardW, cardH, cfg.color, headerText, message)
		local startTarget = get_target_pos(cardW, cardH, 14)
		inst.Position = get_offscreen_pos(cardW, startTarget.Y.Scale, startTarget.Y.Offset)

		notification.Instance = inst
		notification.Duration = dur
		notification.Remaining = dur
		notification.Type = nType
		notification._paused = false

		inst.Parent = notificationContainer
		table.insert(activeNotifications, notification)

		inst.Activated:Connect(function()
			notification:Dismiss()
		end)
		inst.MouseEnter:Connect(function()
			notification._paused = true
			outerStroke.Color = cfg.color:Lerp(Theme.Stroke, 0.45)
		end)
		inst.MouseLeave:Connect(function()
			notification._paused = false
			outerStroke.Color = Theme.Stroke
		end)

		reflow_notifications()

		task.spawn(function()
			local lastTick = os.clock()
			while library_alive and inst.Parent and not notification._dismissing do
				local now = os.clock()
				local dt = now - lastTick
				lastTick = now
				if not notification._paused then
					notification.Remaining = math.max(0, notification.Remaining - dt)
					fill.Size = UDim2.new(math.clamp(notification.Remaining / dur, 0, 1), 0, 1, 0)
					if notification.Remaining <= 0 then
						notification:Dismiss()
						break
					end
				end
				task.wait(0.03)
			end
		end)

		return notification
	end

	function notificationHandler:Dismiss()
		if not self.Instance or not self.Instance.Parent or self._dismissing then return end
		self._dismissing = true
		local sz = self.Instance.Size
		local curPos = self.Instance.Position
		local outPos = get_offscreen_pos(sz.X.Offset, curPos.Y.Scale, curPos.Y.Offset)
		for i, n in ipairs(activeNotifications) do
			if n == self then
				table.remove(activeNotifications, i)
				break
			end
		end
		reflow_notifications()
		tweenservice:Create(self.Instance, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
			Position = outPos
		}):Play()
		task.delay(0.22, function()
			if self.Instance then
				pcall(function() self.Instance:Destroy() end)
			end
		end)
	end
end

local currentGameId = tostring(game.PlaceId)
local configFolder = "BSMT_Configs"
local gameConfigFolder = configFolder .. "/" .. currentGameId

local function ensure_config_folders()
	if not isfolder or not makefolder then return false end
	pcall(function()
		if not isfolder(configFolder) then makefolder(configFolder) end
		if not isfolder(gameConfigFolder) then makefolder(gameConfigFolder) end
	end)
	return true
end
ensure_config_folders()

local function snapshot_config_table()
	local payload = {}
	for k, v in pairs(_G.BSMTConfigData) do
		if typeof(v) == "Color3" then
			payload[k] = { math.round(v.R * 255), math.round(v.G * 255), math.round(v.B * 255) }
		elseif type(v) == "boolean" or type(v) == "number" or type(v) == "string" or type(v) == "table" then
			payload[k] = v
		end
	end
	for k in pairs(synced_flags) do
		local gv = read_flag_val(k)
		if gv ~= nil then
			if typeof(gv) == "Color3" then
				payload[k] = { math.round(gv.R * 255), math.round(gv.G * 255), math.round(gv.B * 255) }
			elseif type(gv) == "boolean" or type(gv) == "number" or type(gv) == "string" then
				payload[k] = gv
			elseif type(gv) == "table" then
				payload[k] = deep_copy_table(gv)
			end
		end
	end
	return payload
end

local function apply_config_table(result)
	restore_id()
	if type(result) ~= "table" then return false end
	for identifier, value in pairs(result) do
		_G.BSMTConfigData[identifier] = value
		local curG = read_flag_val(identifier)
		if typeof(curG) == "Color3" then
			local c3 = parse_color(value)
			if c3 then write_flag_val(identifier, c3) end
		elseif synced_flags[identifier] or curG ~= nil then
			if type(value) == "table" then
				write_flag_val(identifier, deep_copy_table(value))
			else
				write_flag_val(identifier, value)
			end
		end
		for_each_config_element(identifier, function(element)
			if element.Type == "Toggle" then
				element:Apply(value == true, true)
			elseif element.Type == "Slider" then
				element:SetValue(value, true)
			elseif element.Type == "Dropdown" then
				element:Set(value, true)
			elseif element.Type == "TextBox" then
				element:SetText(value, true)
			elseif element.Type == "Keybind" then
				local disp, bind = decode_binding(value)
				element:SetBinding(bind, disp)
			elseif element.Type == "ToggleKeybind" then
				local disp, bind = decode_binding(value)
				if bind then
					element.toggle:BindKeyCode(bind)
					if element.instance then
						element.instance.Text = disp
						element.instance.TextColor3 = Theme.Text
					end
				else
					element.toggle:BindKeyCode(nil)
					if element.instance then
						element.instance.Text = "None"
						element.instance.TextColor3 = Theme.TextMuted
					end
				end
			elseif element.Type == "ColorWheel" then
				element:SetColor(value, true)
			elseif element.Type == "WatermarkToggle" then
				element:Apply(nil, value)
			end
		end)
	end
	if type(result.notif_position) == "string" then
		Library.SetNotificationPosition(result.notif_position)
	end
	if type(result.watermark_position) == "string" and Library.Watermark and Library.Watermark.SetPositionPreset then
		Library.Watermark.SetPositionPreset(result.watermark_position)
	end
	if result.ui_auto_scale ~= nil or result.ui_scale_pct ~= nil then
		update_all_ui_scales()
	end
	if tonumber(result.window_width) and tonumber(result.window_height) and Library._activeWindow and Library._activeWindow.SetSize then
		Library._activeWindow:SetSize(tonumber(result.window_width), tonumber(result.window_height), true, true)
	end
	return true
end

function Library.ResetConfig()
	restore_id()
	local defaults = {}
	for k, v in pairs(default_flag_values) do
		defaults[k] = type(v) == "table" and deep_copy_table(v) or v
	end
	apply_config_table(defaults)
	Library.Notification("Reset all settings to defaults", "info", 3, "Config Reset")
	return true
end

function Library.ExportConfig()
	local ok, encoded = pcall(function()
		return httpservice:JSONEncode(snapshot_config_table())
	end)
	return ok and encoded or "{}"
end

function Library.ImportConfig(jsonStr)
	if type(jsonStr) ~= "string" or jsonStr == "" then return false end
	local ok, decoded = pcall(function()
		return httpservice:JSONDecode(jsonStr)
	end)
	if ok and type(decoded) == "table" then
		apply_config_table(decoded)
		Library.Notification("Config imported from JSON!", "success", 3)
		return true
	end
	Library.Notification("Invalid config JSON", "error", 3)
	return false
end

function Library.SaveConfig(configName)
	restore_id()
	if not writefile then
		Library.Notification("Executor doesn't support writefile", "error", 4)
		return false
	end
	ensure_config_folders()
	configName = (configName and configName ~= "") and configName:gsub("[/\\:%*%?\"<>|]", "") or "default"
	if configName == "" then configName = "default" end
	local configPath = gameConfigFolder .. "/" .. configName .. ".cfg"

	local payload = snapshot_config_table()
	local ok, err = pcall(function()
		writefile(configPath, httpservice:JSONEncode(payload))
	end)

	if ok then
		Library._activeProfileName = configName
		Library.Notification("Profile '" .. configName .. "' saved!", "success", 3, "Config Saved")
		return true
	else
		Library.Notification("Failed to save: " .. tostring(err), "error", 4)
		return false
	end
end

function Library.LoadConfig(configName)
	restore_id()
	if not readfile or not isfile then
		Library.Notification("Executor doesn't support readfile", "error", 4)
		return false
	end
	configName = (configName and configName ~= "") and configName or "default"
	local configPath = gameConfigFolder .. "/" .. configName .. ".cfg"

	if not isfile(configPath) then
		Library.Notification("Profile '" .. configName .. "' not found", "warning", 3)
		return false
	end

	local ok, result = pcall(function()
		return httpservice:JSONDecode(readfile(configPath))
	end)

	if ok and type(result) == "table" then
		apply_config_table(result)
		Library._activeProfileName = configName
		Library.Notification("Profile '" .. configName .. "' loaded!", "success", 3, "Config Loaded")
		return true
	else
		Library.Notification("Failed to parse config file", "error", 4)
		return false
	end
end

function Library.DeleteConfig(configName)
	restore_id()
	if not delfile or not isfile then
		Library.Notification("Executor doesn't support delfile", "error", 4)
		return false
	end
	local configPath = gameConfigFolder .. "/" .. (configName or "") .. ".cfg"
	if not isfile(configPath) then
		Library.Notification("Profile '" .. tostring(configName) .. "' not found", "warning", 3)
		return false
	end
	local ok = pcall(function() delfile(configPath) end)
	if ok then
		if Library.GetAutoLoad() == configName then
			Library.SetAutoLoad("")
		end
		if Library._activeProfileName == configName then
			Library._activeProfileName = nil
		end
		Library.Notification("Profile '" .. configName .. "' deleted", "info", 3)
		return true
	else
		Library.Notification("Failed to delete profile", "error", 4)
		return false
	end
end

function Library.GetConfigs()
	if not listfiles or not isfolder then return {} end
	if not isfolder(gameConfigFolder) then return {} end

	local configs = {}
	local ok, files = pcall(function()
		return listfiles(gameConfigFolder)
	end)

	if ok and files then
		for _, filePath in ipairs(files) do
			local fileName = filePath:match("([^/\\]+)%.cfg$")
			if fileName then
				table.insert(configs, fileName)
			end
		end
	end
	table.sort(configs)
	return configs
end

function Library.SetAutoLoad(configName)
	if not writefile then return false end
	ensure_config_folders()
	local autoLoadPath = gameConfigFolder .. "/_autoload.txt"
	local ok = pcall(function()
		writefile(autoLoadPath, configName or "")
	end)
	return ok
end

function Library.GetAutoLoad()
	if not readfile or not isfile then return nil end
	local autoLoadPath = gameConfigFolder .. "/_autoload.txt"
	if isfile(autoLoadPath) then
		local ok, res = pcall(function()
			return readfile(autoLoadPath)
		end)
		if ok and res and res ~= "" then
			return res
		end
	end
	return nil
end

local function set_toggle_visual_state(inst, enabled, animate)
	local track = inst and inst:FindFirstChild("SwitchTrack")
	if not track then return end
	local knob = track:FindFirstChild("SwitchKnob")
	local stroke = track:FindFirstChild("TrackStroke")
	local grad = track:FindFirstChild("TrackGradient")
	local txt = inst:FindFirstChild("ToggleText")
	if not knob then return end
	local knob_w = knob.Size.X.Offset
	local targetTrackCol = enabled and Color3.fromRGB(255, 255, 255) or Theme.Track
	local targetKnobPos = enabled and UDim2.new(1, -(knob_w + 2.5), 0.5, 0) or UDim2.new(0, 2.5, 0.5, 0)
	local targetKnobCol = enabled and Theme.TextBright or Theme.TextMuted
	if grad then grad.Enabled = enabled end
	if stroke then stroke.Color = enabled and Theme.AccentBright or Theme.StrokeLight end
	if txt then txt.TextColor3 = enabled and Theme.TextBright or Theme.Text end
	if animate then
		local ti = TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		tweenservice:Create(track, ti, { BackgroundColor3 = targetTrackCol }):Play()
		tweenservice:Create(knob, ti, { Position = targetKnobPos, BackgroundColor3 = targetKnobCol }):Play()
	else
		track.BackgroundColor3 = targetTrackCol
		knob.Position = targetKnobPos
		knob.BackgroundColor3 = targetKnobCol
	end
	task.defer(refresh_container_badges, inst)
end

function toggleHandler:Apply(value, runCallback)
	restore_id()
	self.Enabled = (value == true)
	set_toggle_visual_state(self.Instance, self.Enabled, true)

	if self.ConfigIdentifier then
		_G.BSMTConfigData[self.ConfigIdentifier] = self.Enabled
	end
	if self.Flag then
		write_flag_val(self.Flag, self.Enabled)
	end

	if runCallback and self.Callback then
		self.Callback(self.Enabled)
	end
end

function elementHandler:Toggle(toggleName, callback, configIdentifier)
	restore_id()
	local toggle = setmetatable({}, toggleHandler)
	local toggleInstance = original_elements.Toggle:Clone()
	local syncKey = resolve_sync_flag(configIdentifier, toggleName, callback) or toggleName or "N/A"

	toggle.ConfigIdentifier = syncKey
	toggle.Flag = syncKey
	toggle.Type = "Toggle"
	toggle.IdentifierText = toggleName or "N/A"
	toggle.Instance = toggleInstance
	toggle.GuiToRemove = toggleInstance
	toggle.Enabled = false
	toggle.Callback = callback or function() end

	register_config_element(syncKey, toggle)

	local extVal = read_flag_val(syncKey)
	if type(extVal) == "boolean" then
		toggle.Enabled = extVal
	elseif type(_G.BSMTConfigData[syncKey]) == "boolean" then
		toggle.Enabled = _G.BSMTConfigData[syncKey]
	end

	_G.BSMTConfigData[syncKey] = toggle.Enabled
	if configIdentifier or synced_flags[syncKey] or extVal ~= nil then
		write_flag_val(syncKey, toggle.Enabled)
	end

	if self.Type == "SearchBar" then
		self.ChildedElementsInfo[toggleInstance] = toggle
	end

	toggleInstance.Activated:Connect(function()
		toggle:Apply(not toggle.Enabled, true)
	end)

	toggleInstance.ToggleText.Text = toggleName or "N/A"
	set_toggle_visual_state(toggleInstance, toggle.Enabled, false)
	toggleInstance.Parent = self.ElementToParentChildren

	task.defer(function()
		if not toggleInstance.Parent then return end
		local deferredVal = read_flag_val(syncKey)
		if type(deferredVal) == "boolean" and deferredVal ~= toggle.Enabled then
			toggle.Enabled = deferredVal
			_G.BSMTConfigData[syncKey] = deferredVal
			set_toggle_visual_state(toggleInstance, deferredVal, false)
		else
			set_toggle_visual_state(toggleInstance, toggle.Enabled, false)
		end
	end)

	watch_genv(syncKey, function(v)
		if type(v) == "boolean" and v ~= toggle.Enabled then
			toggle:Apply(v, false)
		end
	end)

	return toggle
end

function toggleHandler:Set(bool, callback)
	if typeof(bool) ~= "boolean" then error("First argument must be a boolean.") end
	self:Apply(bool, callback ~= nil)
	if callback then
		callback(bool)
	end
end

function toggleHandler:Remove()
	if self._keyEntry then
		unregister_keybind(self._keyEntry)
		self._keyEntry = nil
	end
	if self.ConfigIdentifier then
		unregister_config_element(self.ConfigIdentifier, self)
	end
	if self._inlineKeyBtn then
		self._inlineKeyBtn:Destroy()
		self._inlineKeyBtn = nil
	end
	if self._keybindRow then
		self._keybindRow:Destroy()
		self._keybindRow = nil
	end
	self.GuiToRemove:Destroy()
end

function toggleHandler:BindKeyCode(bindingOrKeyCode)
	if self._keyEntry then
		unregister_keybind(self._keyEntry)
		self._keyEntry = nil
	end
	if not bindingOrKeyCode then
		self._boundBinding = nil
		return
	end

	local binding
	if typeof(bindingOrKeyCode) == "EnumItem" then
		binding = { kind = "Key", keyCode = bindingOrKeyCode }
	else
		binding = bindingOrKeyCode
	end
	self._boundBinding = binding

	self._keyEntry = register_keybind({
		isListening = function() return self._isBindingKey == true end,
		getBinding = function() return self._boundBinding end,
		callback = function()
			self:Apply(not self.Enabled, true)
		end,
	})
end

function toggleHandler:BindKey(arg, defaultKeyName)
	self:BindKeyCode(nil)

	local function get_keycode(name)
		if not name then return nil end
		for _, kc in pairs(Enum.KeyCode:GetEnumItems()) do
			if kc.Name:lower() == name:lower() then return kc end
		end
		return nil
	end

	local configKey = (self.ConfigIdentifier or self.IdentifierText or "toggle") .. "_keybind"

	if arg ~= nil and defaultKeyName == nil then
		local directCode = get_keycode(arg)
		if directCode then
			self:BindKeyCode({ kind = "Key", keyCode = directCode })
			return self
		end
	end

	local inst = self.Instance
	local track = inst:FindFirstChild("SwitchTrack")
	if not inst or not track then return self end

	if self._inlineKeyBtn then self._inlineKeyBtn:Destroy() end

	local keyBtn = Instance.new("TextButton")
	keyBtn.Name = "InlineKeybind"
	keyBtn.Parent = inst
	keyBtn.AnchorPoint = Vector2.new(1, 0.5)
	keyBtn.Position = UDim2.new(1, -(track.Size.X.Offset + 8), 0.5, 0)
	keyBtn.Size = UDim2.fromOffset(42, M.ToggleH - 4)
	keyBtn.BackgroundColor3 = Theme.Element
	keyBtn.BorderSizePixel = 0
	keyBtn.AutoButtonColor = false
	keyBtn.Font = Enum.Font.GothamMedium
	keyBtn.Text = "None"
	keyBtn.TextColor3 = Theme.TextMuted
	keyBtn.TextSize = M.TextSizeSm - 1
	keyBtn.TextTruncate = Enum.TextTruncate.AtEnd

	local kc = Instance.new("UICorner")
	kc.CornerRadius = UDim.new(0, 4)
	kc.Parent = keyBtn

	local ks = Instance.new("UIStroke")
	ks.Color = Theme.Stroke
	ks.Thickness = 1
	ks.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ks.Parent = keyBtn

	inst.ToggleText.Size = UDim2.new(1, -(track.Size.X.Offset + 56), 1, 0)

	local savedKey = _G.BSMTConfigData[configKey]
	local startKey = (savedKey and savedKey ~= "") and savedKey or (defaultKeyName or (arg and get_keycode(arg) and arg))
	if startKey then
		local disp, bind = decode_binding(startKey)
		if bind then
			keyBtn.Text = disp
			keyBtn.TextColor3 = Theme.Text
			self:BindKeyCode(bind)
		end
	end

	register_config_element(configKey, {
		Type = "ToggleKeybind",
		toggle = self,
		instance = keyBtn,
	})

	local listenConn = nil
	local function clear_inline_bind()
		if listenConn then listenConn:Disconnect() listenConn = nil end
		self._isBindingKey = false
		keyBtn.Text = "None"
		keyBtn.TextColor3 = Theme.TextMuted
		ks.Color = Theme.Stroke
		self:BindKeyCode(nil)
		_G.BSMTConfigData[configKey] = ""
	end

	local touchHoldToken = 0
	keyBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			touchHoldToken += 1
			local myToken = touchHoldToken
			task.delay(0.45, function()
				if touchHoldToken == myToken then
					clear_inline_bind()
				end
			end)
		end
	end)
	keyBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			touchHoldToken += 1
		end
	end)

	keyBtn.Activated:Connect(function()
		if self._isBindingKey then return end
		self._isBindingKey = true
		keyBtn.Text = "..."
		keyBtn.TextColor3 = Theme.Accent
		ks.Color = Theme.Accent
		if listenConn then listenConn:Disconnect() end
		listenConn = uis.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape then
				clear_inline_bind()
				return
			end
			local dispName, binding = resolve_binding(input)
			if not binding then return end
			listenConn:Disconnect()
			listenConn = nil
			keyBtn.Text = dispName
			keyBtn.TextColor3 = Theme.Text
			ks.Color = Theme.Stroke
			self:BindKeyCode(binding)
			_G.BSMTConfigData[configKey] = encode_binding(binding)
			task.defer(function() self._isBindingKey = false end)
		end)
	end)

	keyBtn.MouseButton2Click:Connect(clear_inline_bind)

	self._inlineKeyBtn = keyBtn
	return self
end

function windowHandler:SetKeybind(keybind)
	for _, kc in pairs(Enum.KeyCode:GetEnumItems()) do
		if kc.Name:lower() == tostring(keybind):lower() then
			self.CurrentKeybind = kc
			return
		end
	end
	self.CurrentKeybind = Enum.KeyCode.RightShift
end

