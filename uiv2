			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = Vector2.new(Toggle.Position.X.Offset, Toggle.Position.Y.Offset)
		end
	end)

	track_conn(uis.InputChanged:Connect(function(input)
		if dragging and is_move_input(input) then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			if delta.Magnitude > 5 then moved = true end
			local vp = cam.ViewportSize
			local sc = math.max(0.7, scale_factor)
			local w = Toggle.Size.X.Offset * sc
			local h = Toggle.Size.Y.Offset * sc
			local newX = math.clamp(startPos.X + delta.X, 6, math.max(6, vp.X - w - 6))
			local newY = math.clamp(startPos.Y + delta.Y, 6, math.max(6, vp.Y - h - 6))
			Toggle.Position = UDim2.fromOffset(math.round(newX), math.round(newY))
		end
