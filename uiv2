	textParams.Font = lbl.FontFace
	textParams.Size = lbl.TextSize
	textParams.Width = math.max(50, lbl.AbsoluteSize.X - 16)

	for i, anim in pairs(self.PlayingAnimations) do
		coroutine.close(anim)
		self.PlayingAnimations[i] = nil
	end

	local ok, bounds = pcall(function() return textservice:GetTextBoundsAsync(textParams) end)
	if ok and bounds then
		self.Instance.Size = UDim2.new(1, 0, 0, math.max(M.ElementH, bounds.Y + 10))
	end

	if playAnimation then
		local co = coroutine.create(function()
			for i = 1, #newText do
				lbl.Text = string.sub(newText or "N/A", 1, i)
				task.wait(0.01)
			end
		end)
		table.insert(self.PlayingAnimations, co)
		coroutine.resume(co)
	else
		lbl.Text = newText or "N/A"
	end
end

