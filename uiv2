				if bg then
					bg.Visible = not bg.Visible
					UIStroke.Color = bg.Visible and Theme.Accent or Theme.StrokeLight
					statusDot.BackgroundColor3 = bg.Visible and Theme.Success or Theme.TextDim
					local shrink = tweenservice:Create(Toggle, TweenInfo.new(0.1, Enum.EasingStyle.Quad), { Size = UDim2.fromOffset(82, 31) })
					local grow = tweenservice:Create(Toggle, TweenInfo.new(0.14, Enum.EasingStyle.Quad), { Size = UDim2.fromOffset(88, 34) })
					shrink:Play()
					shrink.Completed:Once(function() grow:Play() end)
				end
			end
		end
	end))

	self.MobileButton = Toggle
	self.MobileButtonGui = ToggleGui
	self:SetupChatCommands()

	return Toggle
end

function windowHandler:SetupChatCommands()
	if self._chatCommandsSetup then return end
	self._chatCommandsSetup = true

	player.Chatted:Connect(function(message)
		local lowerMsg = message:lower():gsub("%s+", "")
		if lowerMsg == "/eshow" then
			if self.MobileButton then self.MobileButton.Visible = true end
		elseif lowerMsg == "/ehide" then
			if self.MobileButton then self.MobileButton.Visible = false end
		elseif lowerMsg == "/etoggle" then
			local bg = self.Instance:FindFirstChild("Background")
			if bg then bg.Visible = not bg.Visible end
		end
	end)
end

function windowHandler:ShowMobileButton()
	if self.MobileButton then self.MobileButton.Visible = true end
end

function windowHandler:HideMobileButton()
	if self.MobileButton then self.MobileButton.Visible = false end
end

function windowHandler:RemoveMobileButton()
	if self.MobileButtonGui then
		self.MobileButtonGui:Destroy()
		self.MobileButtonGui = nil
		self.MobileButton = nil
	end
end

