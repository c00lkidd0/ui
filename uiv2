		local clip = setclipboard or toclipboard
		if not clip then
			Library.Notification("Executor doesn't support setclipboard", "error", 3)
			return
		end
		clip(Library.ExportConfig())
		Library.Notification("Config JSON copied to clipboard!", "success", 3)
	end)

	leftSec:TextBox("Import JSON", function(jsonText)
		if jsonText and jsonText ~= "" then
			Library.ImportConfig(jsonText)
		end
	end)

	local currentAutoLoad = Library.GetAutoLoad() or ""
	local autoToggle = rightSec:Toggle("Auto-Load Selected Profile", function(enabled)
		if enabled then
			if currentConfigName and currentConfigName ~= "" then
				Library.SetAutoLoad(currentConfigName)
				Library.Notification("Auto-load set to: " .. currentConfigName, "success", 2)
				refresh_profiles()
			else
				Library.Notification("Select a profile first", "warning", 2)
			end
		else
			Library.SetAutoLoad("")
			Library.Notification("Auto-load disabled", "info", 2)
			refresh_profiles()
		end
	end, "autoload_enabled")

	autoToggle:Set(currentAutoLoad ~= "")
	refresh_profiles()

	local wmToggle = rightSec:Toggle("Show HUD Watermark", function(enabled)
		if Library.Watermark then
			Library.Watermark.SetVisible(enabled)
		end
	end, "watermark_enabled")
	local wmInitial = _G.BSMTConfigData["watermark_enabled"]
	wmToggle:Set(wmInitial == nil and true or wmInitial)

	do
		local keybindRow = original_elements.Keybind:Clone()
		local keyText = keybindRow.BoxBackground.KeyText
		local boxBackground = keybindRow.BoxBackground
		local keybindTextLbl = keybindRow.KeybindText

		keybindTextLbl.Text = "Menu Toggle Key"
		keyText.Text = self.CurrentKeybind and self.CurrentKeybind.Name or "RightShift"
		keybindRow.Parent = rightSec.ElementToParentChildren
		if boxBackground:FindFirstChild("BoxAspect") then boxBackground.BoxAspect:Destroy() end

		local isListening = false
		local listenConn = nil

		keybindRow.Activated:Connect(function()
			if isListening then return end
			isListening = true
			keyText.Text = "..."
			keyText.TextColor3 = Theme.Accent
			if listenConn then listenConn:Disconnect() end
			listenConn = uis.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				if input.KeyCode == Enum.KeyCode.Unknown then return end
				isListening = false
				listenConn:Disconnect()
				listenConn = nil
				local keyName = input.KeyCode.Name
				self:SetKeybind(keyName)
				keyText.Text = keyName
				keyText.TextColor3 = Theme.Text
				Library.Notification("Menu keybind → " .. keyName, "success", 2)
			end)
		end)

		keybindRow.MouseButton2Click:Connect(function()
			if listenConn then listenConn:Disconnect() listenConn = nil end
			isListening = false
			self:SetKeybind("RightShift")
			keyText.Text = "RightShift"
			keyText.TextColor3 = Theme.TextMuted
		end)
	end

	rightSec:Title("Session")
	local uptimeLabel = rightSec:Label("Uptime: 00:00")

	do
		local ok, uptimeText = pcall(function()
			return uptimeLabel.Instance.LabelBackground.LabelText
		end)
		if ok and uptimeText then
			local lastStr
			on_slow_tick(function()
				local t = Library._scriptStartTime
				if not t then return end
				local secs = math.floor(tick() - t)
				local h = math.floor(secs / 3600)
				local m = math.floor((secs % 3600) / 60)
				local s = secs % 60
				local str = h > 0 and string.format("Uptime: %d:%02d:%02d", h, m, s) or string.format("Uptime: %02d:%02d", m, s)
				if str ~= lastStr then
					lastStr = str
					uptimeText.Text = str
				end
			end)
		end
	end

	return configTab
end

