		bodyLbl.Size = UDim2.new(1, -22, 1, -33)
		bodyLbl.Font = Enum.Font.Gotham
		bodyLbl.Text = bodyStr
		bodyLbl.TextColor3 = Theme.Text
		bodyLbl.TextSize = 12
		bodyLbl.TextWrapped = true
