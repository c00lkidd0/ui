local function register_config_element(key, elem)
	if not key then return end
	local bucket = _G.BSMTConfigElements[key]
	if not bucket then
		_G.BSMTConfigElements[key] = { elem }
	elseif bucket.Type then
		_G.BSMTConfigElements[key] = { bucket, elem }
	else
		table.insert(bucket, elem)
	end
end

local function unregister_config_element(key, elem)
	if not key then return end
	local bucket = _G.BSMTConfigElements[key]
	if not bucket then return end
	if bucket == elem then
		_G.BSMTConfigElements[key] = nil
	elseif type(bucket) == "table" and not bucket.Type then
		for i = #bucket, 1, -1 do
			if bucket[i] == elem then table.remove(bucket, i) end
		end
		if #bucket == 0 then _G.BSMTConfigElements[key] = nil end
	end
end

local function for_each_config_element(key, fn)
	local bucket = _G.BSMTConfigElements[key]
	if not bucket then return end
	if bucket.Type then
		fn(bucket)
	elseif type(bucket) == "table" then
		for _, elem in ipairs(bucket) do
			fn(elem)
		end
	end
end

