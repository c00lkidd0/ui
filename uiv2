local function parent_protected(gui)
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(gui)
		elseif protectgui then protectgui(gui)
		elseif protect_gui then protect_gui(gui) end
	end)
	local ok = pcall(function()
		if gethui then
			gui.Parent = gethui()
		elseif cloneref then
			gui.Parent = cloneref(coregui)
		else
			gui.Parent = coregui
		end
	end)
	if not ok or not gui.Parent then
		pcall(function() gui.Parent = player:WaitForChild("PlayerGui") end)
	end
	return gui
end

