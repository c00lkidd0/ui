function Library.Notification(message, notifType, duration)
	local notification = setmetatable({}, notificationHandler)
	if not notificationContainer then
		notificationContainer = create_notification_container()
	end

	local inst = create_notification()
	local pill = inst.Background

	message = message or "Notification"
	notifType = notifType or "info"
	duration = duration or 4

	local typeConfigs = {
		success = { title = "Success", icon = "rbxassetid://11295279671", color = Color3.fromRGB(75, 210, 130) },
		error   = { title = "Error",   icon = "rbxassetid://11295280827", color = Color3.fromRGB(235, 80, 80) },
		warning = { title = "Warning", icon = "rbxassetid://11295279671", color = Color3.fromRGB(240, 185, 65) },
		info    = { title = "Info",    icon = "rbxassetid://11454041890", color = Theme.Accent },
	}
	local cfg = typeConfigs[notifType:lower()] or typeConfigs.info

	pill.AccentBar.BackgroundColor3 = cfg.color
	pill.Icon.Image = cfg.icon
	pill.Icon.ImageColor3 = cfg.color
	pill.TitleLabel.Text = cfg.title
	pill.TitleLabel.TextColor3 = cfg.color
	pill.TextLabel.Text = message
	pill.ProgressBar.ProgressBarInner.BackgroundColor3 = cfg.color

	notification.Instance = inst
	notification.Duration = duration
	notification.Type = notifType

	inst.Parent = notificationContainer
	table.insert(activeNotifications, notification)

	pill.CloseBtn.Activated:Connect(function()
		notification:Dismiss()
	end)

	tweenservice:Create(inst, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Position = UDim2.new(1, -302, 0, 12)
	}):Play()

	update_notification_positions()

	local fill = pill.ProgressBar.ProgressBarInner
	task.delay(0.25, function()
		if fill and fill.Parent then
			tweenservice:Create(fill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) }):Play()
		end
	end)

	task.delay(duration, function()
		notification:Dismiss()
	end)

	return notification
end

function notificationHandler:Dismiss()
	if not self.Instance or not self.Instance.Parent or self._dismissing then return end
	self._dismissing = true
	tweenservice:Create(self.Instance, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
		Position = UDim2.new(1, 310, 0, self.Instance.Position.Y.Offset)
	}):Play()
	task.delay(0.26, function()
		for i, n in ipairs(activeNotifications) do
			if n == self then
				table.remove(activeNotifications, i)
				break
			end
		end
		if self.Instance then self.Instance:Destroy() end
		update_notification_positions()
	end)
end

local currentGameId = tostring(game.PlaceId)
