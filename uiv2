	local nameBox = leftSec:TextBox("Profile Name", function(text)
		if text and text ~= "" then
			currentConfigName = text:gsub("^%s+", ""):gsub("%s+$", "")
		end
	end)

	local profileDropdown = leftSec:Dropdown("Saved Profiles: None", {}, function(selected)
		local cleanName = tostring(selected):gsub(" %[Auto%]$", "")
		if cleanName ~= "" and cleanName ~= "No profiles found" then
			currentConfigName = cleanName
			nameBox:SetText(cleanName, false)
		end
	end)

	refresh_profiles = function()
		restore_id()
		local list = Library.GetConfigs()
		local auto = Library.GetAutoLoad()
		local displayList = {}
		for _, nm in ipairs(list) do
			table.insert(displayList, nm .. (auto == nm and " [Auto]" or ""))
		end
		profileDropdown:SetOptions(displayList)
		if #list == 0 then
			profileDropdown:ChangeText("Saved Profiles: None")
		elseif currentConfigName and table.find(list, currentConfigName) then
			profileDropdown:ChangeText("Saved Profiles: " .. currentConfigName .. (auto == currentConfigName and " [Auto]" or ""))
		else
			currentConfigName = list[1]
			nameBox:SetText(currentConfigName, false)
			profileDropdown:ChangeText("Saved Profiles: " .. currentConfigName .. (auto == currentConfigName and " [Auto]" or ""))
		end
		local activeStr = Library._activeProfileName or currentConfigName or "default"
		local autoStr = (auto and auto ~= "") and auto or "Off"
		statusLabel:ChangeText(string.format("Active: %s | Auto: %s | Saved: %d", activeStr, autoStr, #list))
	end

	leftSec:Button("Save / Overwrite Profile", function()
		local rawName = nameBox.Instance.BoxBackground.InnerBox.TextBoxText.Text
		if rawName and rawName ~= "" then currentConfigName = rawName end
		if Library.SaveConfig(currentConfigName) then
			refresh_profiles()
