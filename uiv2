local BINDABLE_MOUSE_TYPES = {
	[Enum.UserInputType.MouseButton1] = "MB1",
	[Enum.UserInputType.MouseButton2] = "MB2",
	[Enum.UserInputType.MouseButton3] = "MB3",
}

local MOUSE_DISPLAY = {
	MB1 = "LClick", MB2 = "RClick", MB3 = "M3",
}

local function resolve_binding(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.Unknown then return nil, nil end
		return input.KeyCode.Name, { kind = "Key", keyCode = input.KeyCode }
	end
	local mb_name = BINDABLE_MOUSE_TYPES[input.UserInputType]
	if mb_name then
		return MOUSE_DISPLAY[mb_name] or mb_name, { kind = "Mouse", inputType = input.UserInputType }
	end
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		local dir = input.Position.Z > 0 and 1 or -1
		local disp = dir > 0 and "ScrlUp" or "ScrlDn"
		return disp, { kind = "Scroll", direction = dir }
	end
	return nil, nil
end

local function binding_matches(input, binding)
	if not binding then return false end
	if binding.kind == "Key" then
		return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == binding.keyCode
	elseif binding.kind == "Mouse" then
		return input.UserInputType == binding.inputType
	elseif binding.kind == "Scroll" then
		return input.UserInputType == Enum.UserInputType.MouseWheel and ((input.Position.Z > 0) == (binding.direction > 0))
	end
	return false
end

local keybind_registry = {}
local keybind_dispatch = nil

local function ensure_keybind_dispatch()
	if keybind_dispatch then return end
	keybind_dispatch = track_conn(uis.InputBegan:Connect(function(input, gp)
		if gp then return end
		for entry in pairs(keybind_registry) do
			if not entry.isListening() and binding_matches(input, entry.getBinding()) then
				task.spawn(entry.callback)
			end
		end
	end))
end

local function register_keybind(entry)
	keybind_registry[entry] = true
	ensure_keybind_dispatch()
	return entry
end

local function unregister_keybind(entry)
	if entry then keybind_registry[entry] = nil end
end

local function encode_binding(binding)
	if not binding then return "" end
	if binding.kind == "Key" then return "Key:" .. binding.keyCode.Name end
	if binding.kind == "Mouse" then return "Mouse:" .. binding.inputType.Name end
	if binding.kind == "Scroll" then return "Scroll:" .. tostring(binding.direction) end
	return ""
end

local function decode_binding(str)
	if not str or str == "" then return nil, nil end
	local kind, val = str:match("^(%a+):(.+)$")
	if kind == "Key" then
		for _, kc in pairs(Enum.KeyCode:GetEnumItems()) do
			if kc.Name == val then
				return kc.Name, { kind = "Key", keyCode = kc }
			end
		end
	elseif kind == "Mouse" then
		for ut, name in pairs(BINDABLE_MOUSE_TYPES) do
			if ut.Name == val then
				return MOUSE_DISPLAY[name] or name, { kind = "Mouse", inputType = ut }
			end
		end
	elseif kind == "Scroll" then
		local d = tonumber(val)
		if d then
			return (d > 0 and "ScrlUp" or "ScrlDn"), { kind = "Scroll", direction = d }
		end
	end
	for _, kc in pairs(Enum.KeyCode:GetEnumItems()) do
		if kc.Name:lower() == tostring(str):lower() then
			return kc.Name, { kind = "Key", keyCode = kc }
		end
	end
	return nil, nil
end

