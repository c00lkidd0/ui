		local rawName = nameBox.Instance.BoxBackground.InnerBox.TextBoxText.Text
		if rawName and rawName ~= "" then currentConfigName = rawName end
		if Library.SaveConfig(currentConfigName) then
			refresh_profiles()
		end
	end)

	leftSec:Button("Load Selected Profile", function()
		if currentConfigName and currentConfigName ~= "" then
			Library.LoadConfig(currentConfigName)
		else
			Library.Notification("Select or enter a profile name", "warning", 3)
		end
	end)

	leftSec:Button("Delete Selected Profile", function()
		if currentConfigName and currentConfigName ~= "" then
			if Library.DeleteConfig(currentConfigName) then
				refresh_profiles()
			end
		end
	end)

