function windowHandler:Tab(tabName, tabImage)
	local tab = setmetatable({}, tabHandler)
	local tabInstance = original_elements.Tab:Clone()
	local pageInstance = original_elements.Page:Clone()

	local tabOpenTween = tweenservice:Create(tabInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundTransparency = 0.25 })
	local tabCloseTween = tweenservice:Create(tabInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })
	local tabSepOpenTween = tweenservice:Create(tabInstance.TabSeperator, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundTransparency = 0 })
	local tabSepCloseTween = tweenservice:Create(tabInstance.TabSeperator, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })
	local tabTextOpenTween = tweenservice:Create(tabInstance.TabText, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { TextColor3 = Theme.TextBright })
	local tabTextCloseTween = tweenservice:Create(tabInstance.TabText, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { TextColor3 = Theme.TextDim })
	local tabImageOpenTween = tweenservice:Create(tabInstance.TabImage, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { ImageColor3 = Theme.Accent })
	local tabImageCloseTween = tweenservice:Create(tabInstance.TabImage, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { ImageColor3 = Theme.TextDim })

	local function is_first_tab()
		local count = 0
		for _, ch in ipairs(self.Instance.Background.Holder.Tabs:GetChildren()) do
			if ch:IsA("TextButton") then count += 1 end
		end
		return count == 1
	end

	tabInstance.MouseEnter:Connect(function()
		if not pageInstance.Visible then
			tweenservice:Create(tabInstance, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { BackgroundTransparency = 0.65 }):Play()
		end
	end)

	tabInstance.MouseLeave:Connect(function()
		if not pageInstance.Visible then
			tabCloseTween:Play()
		end
	end)

	local function select_tab()
		local selfInfo = self.TabInfo[tabInstance]
		if selfInfo.isOpen then return end

		for foundTab, info in pairs(self.TabInfo) do
			if foundTab ~= tabInstance and info.isOpen then
				info.isOpen = false
				info.Page.Visible = false
				local ct = info.CloseTweens
				ct.Tab:Play()
				ct.Seperator:Play()
				ct.Text:Play()
				ct.Image:Play()
			end
		end

		selfInfo.isOpen = true
		pageInstance.Visible = true
		tabOpenTween:Play()
		tabSepOpenTween:Play()
		tabTextOpenTween:Play()
		tabImageOpenTween:Play()
	end

	tab.Type = "Tab"
	tab.IdentifierText = tabName or "N/A"
	tab.TabToRemove = tabInstance
	tab.PageToRemove = pageInstance
	tab.ElementToParentChildren = pageInstance

	tabInstance.TabText.Text = tabName or "N/A"
	tabInstance.TabImage.Image = tabImage or "rbxassetid://11436779516"

	tabInstance.Activated:Connect(select_tab)

	self.TabInfo[tabInstance] = {
		Page = pageInstance,
		isOpen = false,
		CloseTweens = {
			Tab = tabCloseTween,
			Seperator = tabSepCloseTween,
			Text = tabTextCloseTween,
			Image = tabImageCloseTween,
		},
	}

	tabInstance.Parent = self.Instance.Background.Holder.Tabs
	pageInstance.Parent = self.Instance.Background.Holder

	if is_first_tab() then
		tabInstance.TabSeperator.BackgroundTransparency = 0
		tabInstance.BackgroundTransparency = 0.25
		tabInstance.TabText.TextColor3 = Theme.TextBright
		tabInstance.TabImage.ImageColor3 = Theme.Accent
		pageInstance.Visible = true
		self.TabInfo[tabInstance].isOpen = true
	end

	for _, sf in ipairs(pageInstance:GetChildren()) do
		if sf:IsA("ScrollingFrame") then
			local list = sf:FindFirstChildWhichIsA("UIListLayout")
			if list then
				sf.ScrollingEnabled = true
				sf.ClipsDescendants = true
				sf.Active = true
				auto_canvas_size(sf, list, 16)
			end
		end
	end

	return tab
end

