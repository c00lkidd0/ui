function elementHandler:Remove()
	if self.ConfigIdentifier then
		unregister_config_element(self.ConfigIdentifier, self)
	end
	self.GuiToRemove:Destroy()
end

local function refresh_container_badges(inst)
	if not inst then return end
	local sec_frame = inst
	while sec_frame and sec_frame.Name ~= "Section" do
		sec_frame = sec_frame.Parent
	end
	if sec_frame then
		local holder = sec_frame:FindFirstChild("ElementHolder")
		local head = sec_frame:FindFirstChild("Heading")
		local badge = head and head:FindFirstChild("ActiveBadge")
		if holder and badge then
			local count = 0
			for _, d in ipairs(holder:GetDescendants()) do
				if d.Name == "SwitchTrack" and d:FindFirstChild("TrackGradient") and d.TrackGradient.Enabled then
					count += 1
				end
			end
			badge.Visible = count > 0
			if badge:FindFirstChild("BadgeText") then
				badge.BadgeText.Text = tostring(count) .. " ON"
			end
		end
	end
	if Library._activeWindow and Library._activeWindow.TabInfo then
		for tabBtn, info in pairs(Library._activeWindow.TabInfo) do
			local page = info.Page
			local tBadge = tabBtn:FindFirstChild("TabBadge")
			if page and tBadge then
				local total = 0
				for _, d in ipairs(page:GetDescendants()) do
					if d.Name == "SwitchTrack" and d:FindFirstChild("TrackGradient") and d.TrackGradient.Enabled then
						total += 1
					end
				end
				tBadge.Visible = (total > 0) and (not is_mobile or tabBtn.TabText.Visible)
				if tBadge:FindFirstChild("BadgeText") then
					tBadge.BadgeText.Text = tostring(total)
				end
			end
		end
	end
end

function Library.new(windowName, constrainToScreen, width, height, visibilityKeybind, brandImage)
	restore_id()
	library_alive = true
	local window = setmetatable({}, windowHandler)
	local windowInstance = original_elements.Window:Clone()
	local background = windowInstance.Background
	local heading = background.Heading
	local buttonHolder = heading.ButtonHolder
	local holder = background.Holder
	local resizeGrip = background:FindFirstChild("ResizeGrip")
	local resizeRight = background:FindFirstChild("ResizeRight")
	local resizeBottom = background:FindFirstChild("ResizeBottom")

	attach_ui_scale(background)
	update_all_ui_scales()

	window.IsHidden = false
	window.TabInfo = {}
	window.Type = "Window"
	window.Instance = windowInstance
	window.GuiToRemove = windowInstance
	window.isConstraintedToScreenBoundaries = constrainToScreen == nil and true or constrainToScreen
	window.IsMinimized = false
	window.RailExpanded = false

	local function get_keycode_from_name(name)
		if not name then return end
		for _, kc in pairs(Enum.KeyCode:GetEnumItems()) do
			if kc.Name:lower() == name:lower() then
				return kc
			end
		end
	end

	window.CurrentKeybind = get_keycode_from_name(visibilityKeybind) or Enum.KeyCode.RightShift
	heading.Title.Text = windowName or "BSMT"

	function window:SetLogo(assetId)
		if not assetId or assetId == "" then return end
		if tostring(assetId):match("^%d+$") then
			assetId = "rbxassetid://" .. tostring(assetId)
		end
		local bIcon = heading:FindFirstChild("BrandIcon")
		local bBadge = heading:FindFirstChild("BrandBadge")
		if bIcon then
			bIcon.Image = assetId
			bIcon.Visible = true
		end
		if bBadge then
			local mono = bBadge:FindFirstChild("BrandMonogram")
			local mDot = bBadge:FindFirstChild("MonoDot")
			if mono then mono.Visible = false end
			if mDot then mDot.Visible = false end
		end
		if self.MobileButton then
			local pod = self.MobileButton:FindFirstChild("IconPod")
			local pIcon = pod and pod:FindFirstChild("PodIcon")
			local pMono = pod and pod:FindFirstChild("PodMono")
			if pIcon then
				pIcon.Image = assetId
				pIcon.Visible = true
			end
			if pMono then pMono.Visible = false end
		end
	end

	local pageLogo = holder:FindFirstChild("PageLogo")
	if pageLogo then
		pageLogo.Image = ICONS.Logo
		pageLogo.ImageTransparency = 0.94
	end
	if brandImage and brandImage ~= "" and brandImage ~= "rbxassetid://11435586663" and brandImage ~= "rbxassetid://10746039695" then
		if pageLogo then
			pageLogo.Image = brandImage
		end
		window:SetLogo(brandImage)
	end
	if Library.Watermark and Library.Watermark.SetTitle and windowName then
		pcall(Library.Watermark.SetTitle, windowName)
	end
	parent_protected(windowInstance)

	local cur_vp = cam.ViewportSize
	local eff_sc = math.max(0.7, scale_factor)
	local max_logical_w = math.floor((cur_vp.X - 16) / eff_sc)
	local max_logical_h = math.floor((cur_vp.Y - 16) / eff_sc)
	local min_w = is_mobile and 420 or 500
	local min_h = is_mobile and 250 or 310
	local default_w = width or (is_mobile and math.clamp(math.round(max_logical_w * 0.78), 460, 580) or 700)
	local default_h = height or (is_mobile and math.clamp(math.round(max_logical_h * 0.80), 285, 385) or 460)

	local saved_w = tonumber(_G.BSMTConfigData["window_width"])
	local saved_h = tonumber(_G.BSMTConfigData["window_height"])
	local init_w = (not width and saved_w) or default_w
	local init_h = (not height and saved_h) or default_h

	local w_px = math.clamp(init_w, min_w, math.max(min_w, max_logical_w))
	local h_px = math.clamp(init_h, min_h, math.max(min_h, max_logical_h))

	background.Size = UDim2.fromOffset(w_px, h_px)
	background.Position = UDim2.fromOffset(math.round(cur_vp.X / 2), math.round(cur_vp.Y / 2))

	local head_h = M.HeaderH
	local original_window_size = Vector2.new(w_px, h_px)
	local min_long_size = Vector2.new(w_px, head_h)
	local min_short_size = Vector2.new(math.max(280, math.round(w_px * 0.46)), head_h)

	local function notify_window_resized()
		for fn in pairs(window_resize_listeners) do
			pcall(fn)
		end
	end

	local function set_grip_highlight(active)
		if not resizeGrip then return end
		local col = active and Theme.AccentBright or Theme.Accent
		local tr = active and 0 or 0.35
		for _, ch in ipairs(resizeGrip:GetChildren()) do
			if ch:IsA("Frame") then
				ch.BackgroundColor3 = col
				ch.BackgroundTransparency = tr
			end
		end
	end

	local function set_resize_handles_visible(vis)
		if resizeGrip then resizeGrip.Visible = vis end
		if resizeRight then resizeRight.Visible = vis end
		if resizeBottom then resizeBottom.Visible = vis end
	end

	function window:SetSize(nw, nh, animate, saveToConfig)
		local vp = cam.ViewportSize
		local sc = math.max(0.7, scale_factor)
		local lim_w = math.max(min_w, math.floor((vp.X - 12) / sc))
		local lim_h = math.max(min_h, math.floor((vp.Y - 12) / sc))
		local cw = math.clamp(math.round(tonumber(nw) or original_window_size.X), min_w, lim_w)
		local ch = math.clamp(math.round(tonumber(nh) or original_window_size.Y), min_h, lim_h)
		original_window_size = Vector2.new(cw, ch)
		min_long_size = Vector2.new(cw, head_h)
		min_short_size = Vector2.new(math.max(280, math.round(cw * 0.46)), head_h)
		if saveToConfig ~= false then
			_G.BSMTConfigData["window_width"] = cw
			_G.BSMTConfigData["window_height"] = ch
		end
		if not self.IsMinimized then
			if animate then
				tweenservice:Create(background, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.fromOffset(cw, ch)
				}):Play()
			else
				background.Size = UDim2.fromOffset(cw, ch)
			end
			local half_w = (cw * sc) / 2
			local half_h = (ch * sc) / 2
			local nx = math.clamp(background.Position.X.Offset, half_w, math.max(half_w, vp.X - half_w))
			local ny = math.clamp(background.Position.Y.Offset, half_h, math.max(half_h, vp.Y - half_h))
			background.Position = UDim2.fromOffset(nx, ny)
		end
		notify_window_resized()
	end

	function window:GetSize()
		return original_window_size
	end

	function window:ResetSize()
		_G.BSMTConfigData["window_width"] = default_w
		_G.BSMTConfigData["window_height"] = default_h
		self:SetSize(default_w, default_h, true, true)
	end

	function window:SetScale(pct)
		_G.BSMTConfigData["ui_scale_pct"] = math.clamp(tonumber(pct) or 100, 70, 135)
		update_all_ui_scales()
		notify_window_resized()
	end

	local railToggle = holder:FindFirstChild("RailToggle")
	local function set_mobile_rail_expanded(exp)
		if not is_mobile then return end
		window.RailExpanded = exp
		local target_w = exp and M.SidebarExpW or M.SidebarW
		if railToggle then
			railToggle.Text = exp and "«" or "»"
			tweenservice:Create(railToggle, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, target_w, 0, 28)
			}):Play()
		end
		tweenservice:Create(holder.Tabs, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, target_w, 1, -28)
		}):Play()
		tweenservice:Create(holder.SidebarLine, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Position = UDim2.new(0, target_w, 0, 0)
		}):Play()
		for tabBtn in pairs(window.TabInfo) do
			if tabBtn and tabBtn:FindFirstChild("TabText") then
				tabBtn.TabText.Visible = exp
			end
		end
		refresh_container_badges(nil)
	end
	if railToggle then
		railToggle.Activated:Connect(function()
			set_mobile_rail_expanded(not window.RailExpanded)
		end)
	end
	window._collapseMobileRail = function()
		if is_mobile and window.RailExpanded then
			set_mobile_rail_expanded(false)
		end
	end

	local headerSearch = heading:FindFirstChild("HeaderSearch")
	local headerSearchBox = headerSearch and headerSearch:FindFirstChild("SearchBox")
	if headerSearchBox then
		local function apply_global_filter()
			local q = headerSearchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
			for _, info in pairs(window.TabInfo) do
				local page = info.Page
				if page then
					for _, sf in ipairs(page:GetChildren()) do
						if sf:IsA("ScrollingFrame") then
							for _, sec in ipairs(sf:GetChildren()) do
								if sec:IsA("Frame") and sec.Name == "Section" then
									local secTitle = (sec:FindFirstChild("Heading") and sec.Heading:FindFirstChild("Title") and sec.Heading.Title.Text or ""):lower()
									local elHolder = sec:FindFirstChild("ElementHolder")
									if q == "" or secTitle:find(q, 1, true) then
										sec.Visible = true
										if elHolder then
											for _, el in ipairs(elHolder:GetChildren()) do
												if el:IsA("GuiObject") then el.Visible = true end
											end
										end
									elseif elHolder then
										local anyMatch = false
										for _, el in ipairs(elHolder:GetChildren()) do
											if el:IsA("GuiObject") then
												local match = false
												for _, d in ipairs(el:GetDescendants()) do
													if (d:IsA("TextLabel") or d:IsA("TextBox")) and d.Text:lower():find(q, 1, true) then
														match = true
														break
													end
												end
												el.Visible = match
												if match then anyMatch = true end
											end
										end
										sec.Visible = anyMatch
									end
								end
							end
						end
					end
				end
			end
			notify_window_resized()
		end
		headerSearchBox:GetPropertyChangedSignal("Text"):Connect(apply_global_filter)
		headerSearchBox.Focused:Connect(function()
			local st = headerSearch:FindFirstChildWhichIsA("UIStroke")
			if st then st.Color = Theme.Accent end
		end)
		headerSearchBox.FocusLost:Connect(function()
			local st = headerSearch:FindFirstChildWhichIsA("UIStroke")
			if st then st.Color = Theme.StrokeLight end
		end)
	end

	local dragging = false
	local drag_input = nil
	local drag_start_pos = nil
	local win_start_pos = nil

	local resizing = false
	local resize_input = nil
	local resize_axis = "xy"
	local resize_start_mouse = nil
	local resize_start_size = nil
	local resize_start_pos = nil

	local function bind_resize_handle(btn, axis)
		if not btn then return end
		if axis == "xy" then
			btn.MouseEnter:Connect(function()
				if not resizing then set_grip_highlight(true) end
			end)
			btn.MouseLeave:Connect(function()
				if not resizing then set_grip_highlight(false) end
			end)
		end
		btn.InputBegan:Connect(function(input)
			if window.IsMinimized then return end
			if is_primary_input(input) then
				resizing = true
				dragging = false
				resize_axis = axis
				resize_input = input
				resize_start_mouse = Vector2.new(input.Position.X, input.Position.Y)
				resize_start_size = Vector2.new(background.Size.X.Offset, background.Size.Y.Offset)
				resize_start_pos = Vector2.new(background.Position.X.Offset, background.Position.Y.Offset)
				set_grip_highlight(true)
			end
		end)
		btn.InputChanged:Connect(function(input)
			if is_move_input(input) then
				resize_input = input
			end
		end)
	end

	bind_resize_handle(resizeGrip, "xy")
	bind_resize_handle(resizeRight, "x")
	bind_resize_handle(resizeBottom, "y")

	heading.InputBegan:Connect(function(input)
		if resizing then return end
		if is_primary_input(input) then
			dragging = true
			drag_input = input
			drag_start_pos = Vector2.new(input.Position.X, input.Position.Y)
			win_start_pos = Vector2.new(background.Position.X.Offset, background.Position.Y.Offset)
		end
	end)

	heading.InputChanged:Connect(function(input)
		if is_move_input(input) then
			drag_input = input
		end
	end)

	track_conn(uis.InputChanged:Connect(function(input)
		if resizing and (input == resize_input or is_move_input(input)) then
			local sc = math.max(0.7, scale_factor)
			local delta = (Vector2.new(input.Position.X, input.Position.Y) - resize_start_mouse) / sc
			local vp = cam.ViewportSize
			local max_w = math.max(min_w, math.floor((vp.X - 12) / sc))
			local max_h = math.max(min_h, math.floor((vp.Y - 12) / sc))
			local nw = resize_start_size.X
			local nh = resize_start_size.Y
			if resize_axis == "xy" or resize_axis == "x" then
				nw = math.clamp(math.round(resize_start_size.X + delta.X), min_w, max_w)
			end
			if resize_axis == "xy" or resize_axis == "y" then
				nh = math.clamp(math.round(resize_start_size.Y + delta.Y), min_h, max_h)
			end
			local dw = (nw - resize_start_size.X) * sc
			local dh = (nh - resize_start_size.Y) * sc
			local nx = resize_start_pos.X + dw * 0.5
			local ny = resize_start_pos.Y + dh * 0.5
			if window.isConstraintedToScreenBoundaries then
				local hw = (nw * sc) / 2
				local hh = (nh * sc) / 2
				nx = math.clamp(nx, hw, math.max(hw, vp.X - hw))
				ny = math.clamp(ny, hh, math.max(hh, vp.Y - hh))
			end
			background.Size = UDim2.fromOffset(nw, nh)
			background.Position = UDim2.fromOffset(math.round(nx), math.round(ny))
			original_window_size = Vector2.new(nw, nh)
			min_long_size = Vector2.new(nw, head_h)
			min_short_size = Vector2.new(math.max(280, math.round(nw * 0.46)), head_h)
			_G.BSMTConfigData["window_width"] = nw
			_G.BSMTConfigData["window_height"] = nh
			notify_window_resized()
		elseif dragging and (input == drag_input or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - drag_start_pos
			local vp = cam.ViewportSize
			local abs_sz = background.AbsoluteSize
			local nx = win_start_pos.X + delta.X
			local ny = win_start_pos.Y + delta.Y
			if window.isConstraintedToScreenBoundaries then
				nx = math.clamp(nx, abs_sz.X / 2, math.max(abs_sz.X / 2, vp.X - abs_sz.X / 2))
				ny = math.clamp(ny, abs_sz.Y / 2, math.max(abs_sz.Y / 2, vp.Y - abs_sz.Y / 2))
			end
			background.Position = UDim2.fromOffset(nx, ny)
		end
	end))

	track_conn(uis.InputEnded:Connect(function(input)
		if is_primary_input(input) then
			if resizing then
				resizing = false
				resize_input = nil
				set_grip_highlight(false)
				_G.BSMTConfigData["window_width"] = original_window_size.X
				_G.BSMTConfigData["window_height"] = original_window_size.Y
				notify_window_resized()
			end
			dragging = false
			drag_input = nil
		end
	end))

	track_conn(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		update_all_ui_scales()
		local vp = cam.ViewportSize
		local sc = math.max(0.7, scale_factor)
		local lim_w = math.max(min_w, math.floor((vp.X - 12) / sc))
		local lim_h = math.max(min_h, math.floor((vp.Y - 12) / sc))
		local nw = math.min(original_window_size.X, lim_w)
		local nh = math.min(original_window_size.Y, lim_h)
		if not window.IsMinimized then
			background.Size = UDim2.fromOffset(nw, nh)
		end
		local hw = (nw * sc) / 2
		local hh = (nh * sc) / 2
		local nx = math.clamp(background.Position.X.Offset, hw, math.max(hw, vp.X - hw))
		local ny = math.clamp(background.Position.Y.Offset, hh, math.max(hh, vp.Y - hh))
		background.Position = UDim2.fromOffset(nx, ny)
		notify_window_resized()
	end))

	local function close_window()
		local tw = tweenservice:Create(background, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Size = UDim2.fromOffset(0, 0) })
		tw.Completed:Connect(function()
			if window and window._visibilityConn then
				window._visibilityConn:Disconnect()
				window._visibilityConn = nil
			end
			windowInstance:Destroy()
			window = nil
		end)
		tw:Play()
	end

	local normal_title_size = heading.Title.Size

	local function minimize_window()
		window.IsMinimized = true
		holder.Visible = false
		set_resize_handles_visible(false)
		if headerSearch then headerSearch.Visible = false end
		if heading:FindFirstChild("HeadingCornerHiding") then heading.HeadingCornerHiding.Visible = false end
		if heading:FindFirstChild("HeadingSeperator") then heading.HeadingSeperator.Visible = false end
		if heading:FindFirstChild("TopAccentBeam") then heading.TopAccentBeam.Visible = false end
		heading.Title.Size = UDim2.new(1, -124, 1, 0)
		buttonHolder.Minus.Visible = false
		buttonHolder.Plus.Visible = true
		buttonHolder.Plus.Rotation = 0

		local tw_up = tweenservice:Create(background, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(min_long_size.X, min_long_size.Y)
		})

		tw_up.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and window.IsMinimized then
				tweenservice:Create(background, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.fromOffset(min_short_size.X, min_short_size.Y)
				}):Play()
			end
		end)

		tw_up:Play()
	end

	local function maximize_window()
		window.IsMinimized = false
		buttonHolder.Plus.Visible = false
		buttonHolder.Minus.Visible = true
		buttonHolder.Minus.Rotation = 0

		local tw_right = tweenservice:Create(background, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(min_long_size.X, min_long_size.Y)
		})

		tw_right.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and not window.IsMinimized then
				heading.Title.Size = normal_title_size
				if headerSearch then headerSearch.Visible = true end
				if heading:FindFirstChild("HeadingCornerHiding") then heading.HeadingCornerHiding.Visible = true end
				if heading:FindFirstChild("HeadingSeperator") then heading.HeadingSeperator.Visible = true end
				if heading:FindFirstChild("TopAccentBeam") then heading.TopAccentBeam.Visible = true end
				holder.Visible = true
				set_resize_handles_visible(true)
				tweenservice:Create(background, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.fromOffset(original_window_size.X, original_window_size.Y)
				}):Play()
			end
		end)

		tw_right:Play()
	end

	local function setup_win_btn_hover(btn, isClose)
		if not btn then return end
		local st = btn:FindFirstChild("BtnStroke")
		btn.MouseEnter:Connect(function()
			tweenservice:Create(btn, TweenInfo.new(0.14, Enum.EasingStyle.Quad), {
				BackgroundColor3 = isClose and Color3.fromRGB(205, 50, 68) or Theme.ElementLight
			}):Play()
			if st then
				st.Color = isClose and Color3.fromRGB(255, 95, 110) or Theme.Accent
			end
			for _, ch in ipairs(btn:GetChildren()) do
				if ch:IsA("Frame") then
					ch.BackgroundColor3 = Theme.TextBright
				end
			end
		end)
		btn.MouseLeave:Connect(function()
			tweenservice:Create(btn, TweenInfo.new(0.14, Enum.EasingStyle.Quad), {
				BackgroundColor3 = Theme.Element
			}):Play()
			if st then
				st.Color = Theme.StrokeLight
			end
			for _, ch in ipairs(btn:GetChildren()) do
				if ch:IsA("Frame") then
					ch.BackgroundColor3 = Theme.TextMuted
				end
			end
		end)
	end

	setup_win_btn_hover(buttonHolder.Minus, false)
	setup_win_btn_hover(buttonHolder.Plus, false)
	setup_win_btn_hover(buttonHolder.Close, true)

	buttonHolder.Close.Activated:Connect(close_window)
	buttonHolder.Plus.Activated:Connect(maximize_window)
	buttonHolder.Minus.Activated:Connect(minimize_window)

	window._visibilityConn = track_conn(uis.InputBegan:Connect(function(input, gp)
		if input.UserInputType == Enum.UserInputType.Touch and not window.MobileButton then
			is_mobile = true
			Library.Settings.MobileMode = true
			window:CreateMobileButton(nil, true)
		end
		if gp then return end
		if not background or not background.Parent then
			if window and window._visibilityConn then
				window._visibilityConn:Disconnect()
				window._visibilityConn = nil
			end
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == window.CurrentKeybind then
			background.Visible = not background.Visible
		end
	end))

	auto_canvas_size(holder.Tabs, holder.Tabs.TabsUIListLayout, 20)

	if is_mobile or uis.TouchEnabled then
		window:CreateMobileButton(nil, true)
	end

	Library._activeWindow = window
	return window
end

function windowHandler:LockScreenBoundaries(constrain)
	self.isConstraintedToScreenBoundaries = constrain
end

function windowHandler:Tab(tabName, tabImage)
	local tab = setmetatable({}, tabHandler)
	local tabInstance = original_elements.Tab:Clone()
	local pageInstance = original_elements.Page:Clone()

	local resolvedIcon = resolve_tab_icon(tabName, tabImage)
	local tabStroke = tabInstance:FindFirstChild("TabStroke")
	local iconBox = tabInstance:FindFirstChild("IconBox")
	local iconBoxStroke = iconBox and iconBox:FindFirstChild("IconBoxStroke")

	local tabOpenTween = tweenservice:Create(tabInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundTransparency = 0.72 })
	local tabCloseTween = tweenservice:Create(tabInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })
	local tabSepOpenTween = tweenservice:Create(tabInstance.TabSeperator, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundTransparency = 0 })
	local tabSepCloseTween = tweenservice:Create(tabInstance.TabSeperator, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })
	local tabTextOpenTween = tweenservice:Create(tabInstance.TabText, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { TextColor3 = Theme.TextBright })
	local tabTextCloseTween = tweenservice:Create(tabInstance.TabText, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { TextColor3 = Theme.TextMuted })
	local tabImageOpenTween = tweenservice:Create(tabInstance.TabImage, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { ImageColor3 = Theme.AccentBright })
	local tabImageCloseTween = tweenservice:Create(tabInstance.TabImage, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { ImageColor3 = Theme.TextMuted })

	local function apply_tab_extra(open)
		if tabStroke then tabStroke.Transparency = open and 0.45 or 1 end
		if iconBoxStroke then iconBoxStroke.Color = open and Theme.Accent or Theme.Stroke end
		tabInstance.TabText.Font = open and Enum.Font.GothamBold or Enum.Font.GothamMedium
	end

	local function is_first_tab()
		local count = 0
		for _, ch in ipairs(self.Instance.Background.Holder.Tabs:GetChildren()) do
			if ch:IsA("TextButton") then count += 1 end
		end
		return count == 1
	end

	tabInstance.MouseEnter:Connect(function()
		if not pageInstance.Visible then
			tweenservice:Create(tabInstance, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { BackgroundTransparency = 0.85 }):Play()
		end
	end)

	tabInstance.MouseLeave:Connect(function()
		if not pageInstance.Visible then
			tabCloseTween:Play()
		end
	end)

	local function select_tab()
		local selfInfo = self.TabInfo[tabInstance]
		if self._collapseMobileRail then self._collapseMobileRail() end
		if selfInfo.isOpen then return end

		for foundTab, info in pairs(self.TabInfo) do
			if foundTab ~= tabInstance and info.isOpen then
				info.isOpen = false
				info.Page.Visible = false
				local ct = info.CloseTweens
				ct.Tab:Play()
				ct.Seperator:Play()
				ct.Text:Play()
				ct.Image:Play()
				if info.ApplyExtra then info.ApplyExtra(false) end
			end
		end

		selfInfo.isOpen = true
		pageInstance.Visible = true
		tabOpenTween:Play()
		tabSepOpenTween:Play()
		tabTextOpenTween:Play()
		tabImageOpenTween:Play()
		apply_tab_extra(true)
	end

	tab.Type = "Tab"
	tab.IdentifierText = tabName or "N/A"
	tab.TabToRemove = tabInstance
	tab.PageToRemove = pageInstance
	tab.ElementToParentChildren = pageInstance

	tabInstance.TabText.Text = tabName or "N/A"
	tabInstance.TabImage.Image = resolvedIcon

	tabInstance.Activated:Connect(select_tab)

	self.TabInfo[tabInstance] = {
		Page = pageInstance,
		isOpen = false,
		ApplyExtra = apply_tab_extra,
		CloseTweens = {
			Tab = tabCloseTween,
			Seperator = tabSepCloseTween,
			Text = tabTextCloseTween,
			Image = tabImageCloseTween,
		},
	}

	tabInstance.Parent = self.Instance.Background.Holder.Tabs
	pageInstance.Parent = self.Instance.Background.Holder

	if is_first_tab() then
		tabInstance.TabSeperator.BackgroundTransparency = 0
		tabInstance.BackgroundTransparency = 0.72
		tabInstance.TabText.TextColor3 = Theme.TextBright
		tabInstance.TabImage.ImageColor3 = Theme.AccentBright
		apply_tab_extra(true)
		pageInstance.Visible = true
		self.TabInfo[tabInstance].isOpen = true
	end

	for _, sf in ipairs(pageInstance:GetChildren()) do
		if sf:IsA("ScrollingFrame") then
			local list = sf:FindFirstChildWhichIsA("UIListLayout")
			if list then
				sf.ScrollingEnabled = true
				sf.ClipsDescendants = true
				sf.Active = true
				auto_canvas_size(sf, list, 16)
			end
		end
	end

	return tab
end

function tabHandler:Remove()
	self.TabToRemove:Destroy()
	self.PageToRemove:Destroy()
end

function tabHandler:Section(sectionTitle, side)
	local section = setmetatable({}, sectionHandler)
	local sectionInstance = original_elements.Section:Clone()
	local isMaximized = true
	local resizeMinTween = tweenservice:Create(sectionInstance.Heading.ResizeButton, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Rotation = -90 })
	local resizeMaxTween = tweenservice:Create(sectionInstance.Heading.ResizeButton, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Rotation = 0 })

	local function get_needed_height()
		local holder = sectionInstance.ElementHolder
		local pad = holder.ElementHolderPadding
		local content_y = holder.ElementHolderList.AbsoluteContentSize.Y + pad.PaddingBottom.Offset + pad.PaddingTop.Offset
		return math.max(M.SectionHead + 12, sectionInstance.Heading.Size.Y.Offset + content_y)
	end

	local function get_target_column()
		if side and type(side) == "string" then
			local s = side:lower()
			if s == "left" then return self.ElementToParentChildren.LeftScrollingFrame end
			if s == "right" then return self.ElementToParentChildren.RightScrollingFrame end
		end
		local best_sf = self.ElementToParentChildren.LeftScrollingFrame
		local best_y = math.huge
		for _, sf in ipairs(self.ElementToParentChildren:GetChildren()) do
			if sf:IsA("ScrollingFrame") then
				local list = sf:FindFirstChildWhichIsA("UIListLayout")
				if list and list.AbsoluteContentSize.Y < best_y then
					best_sf = sf
					best_y = list.AbsoluteContentSize.Y
				end
			end
		end
		return best_sf
	end

	local function on_resize_click()
		if isMaximized then
			isMaximized = false
			sectionInstance.Heading.HeadingSeperator.Visible = false
			resizeMinTween:Play()
			tweenservice:Create(sectionInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(1, 0, 0, sectionInstance.Heading.Size.Y.Offset)
			}):Play()
		else
			isMaximized = true
			sectionInstance.Heading.HeadingSeperator.Visible = true
			resizeMaxTween:Play()
			tweenservice:Create(sectionInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Size = UDim2.new(1, 0, 0, get_needed_height())
			}):Play()
		end
	end

	section.Type = "Section"
	section.IdentifierText = sectionTitle or "N/A"
	section.Instance = sectionInstance
	section.GuiToRemove = sectionInstance
	section.ElementToParentChildren = sectionInstance.ElementHolder

	sectionInstance.Heading.ResizeButton.Activated:Connect(on_resize_click)

	local resizeQueued = false
	local function apply_section_size()
		if not isMaximized then return end
		local holder = sectionInstance.ElementHolder
		local pad = holder.ElementHolderPadding
		local content_y = holder.ElementHolderList.AbsoluteContentSize.Y + pad.PaddingBottom.Offset + pad.PaddingTop.Offset
		local new_sec_y = get_needed_height()
		local new_hold_y = math.max(12, content_y)

		if sectionInstance.Size.Y.Offset ~= new_sec_y then
			sectionInstance.Size = UDim2.new(1, 0, 0, new_sec_y)
		end
		if holder.Size.Y.Offset ~= new_hold_y then
			holder.Size = UDim2.new(1, 0, 0, new_hold_y)
		end
	end

	local function queue_section_resize()
		if resizeQueued then return end
		resizeQueued = true
		task.defer(function()
			resizeQueued = false
			if sectionInstance.Parent then apply_section_size() end
		end)
	end

	sectionInstance.ElementHolder.ElementHolderList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(queue_section_resize)
	window_resize_listeners[queue_section_resize] = true
	sectionInstance.AncestryChanged:Connect(function(_, parent)
		if not parent then window_resize_listeners[queue_section_resize] = nil end
	end)
	sectionInstance.Heading.Title.Text = sectionTitle or "Section"
	sectionInstance.Parent = get_target_column()
	queue_section_resize()

	return section
end

