	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.DisplayOrder = 999
	screenGui.IgnoreGuiInset = true

	local outer = Instance.new("Frame")
	outer.Name = "Outer"
	outer.Parent = screenGui
	outer.AnchorPoint = Vector2.new(is_mobile and 0.5 or 0, 0)
	outer.Position = is_mobile and UDim2.new(0.5, 0, 0, 10) or UDim2.fromOffset(14, 14)
	outer.Size = UDim2.fromOffset(270, 28)
	outer.BackgroundColor3 = Theme.BackgroundDark
	outer.BorderSizePixel = 0
	outer.Active = true
	attach_ui_scale(outer)

	local outerCorner = Instance.new("UICorner")
	outerCorner.CornerRadius = UDim.new(0, 7)
	outerCorner.Parent = outer

	local outerStroke = Instance.new("UIStroke")
	outerStroke.Color = Theme.StrokeLight
	outerStroke.Thickness = 1
	outerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	outerStroke.Parent = outer

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Parent = outer
	panel.BackgroundColor3 = Theme.Panel
	panel.BorderSizePixel = 0
	panel.Position = UDim2.fromOffset(0, 0)
	panel.Size = UDim2.new(1, 0, 1, 0)

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 7)
	panelCorner.Parent = panel

	local bottomBeam = Instance.new("Frame")
	bottomBeam.Name = "BottomBeam"
	bottomBeam.Parent = panel
	bottomBeam.AnchorPoint = Vector2.new(0.5, 1)
	bottomBeam.Position = UDim2.new(0.5, 0, 1, 0)
	bottomBeam.Size = UDim2.new(1, -12, 0, 1)
	bottomBeam.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	bottomBeam.BorderSizePixel = 0
	bottomBeam.ZIndex = 3

	local bottomBeamGrad = Instance.new("UIGradient")
	bottomBeamGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Panel),
		ColorSequenceKeypoint.new(0.25, Theme.AccentBright),
		ColorSequenceKeypoint.new(0.75, Theme.Accent),
		ColorSequenceKeypoint.new(1, Theme.Panel),
	})
	bottomBeamGrad.Parent = bottomBeam

	local leftAccent = Instance.new("Frame")
	leftAccent.Name = "LeftAccent"
	leftAccent.Parent = outer
	leftAccent.AnchorPoint = Vector2.new(0, 0.5)
	leftAccent.Position = UDim2.new(0, 0, 0.5, 0)
	leftAccent.Size = UDim2.new(0, 2.5, 1, -10)
	leftAccent.BackgroundColor3 = Theme.AccentBright
	leftAccent.BorderSizePixel = 0
	leftAccent.ZIndex = 3

	local leftAccentCorner = Instance.new("UICorner")
	leftAccentCorner.CornerRadius = UDim.new(1, 0)
	leftAccentCorner.Parent = leftAccent

	local row = Instance.new("Frame")
	row.Name = "Row"
	row.Parent = panel
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 1, 0)

	local rowLayout = Instance.new("UIListLayout")
	rowLayout.Parent = row
	rowLayout.FillDirection = Enum.FillDirection.Horizontal
	rowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	rowLayout.Padding = UDim.new(0, 0)
	rowLayout.SortOrder = Enum.SortOrder.LayoutOrder

	local rowPad = Instance.new("UIPadding")
	rowPad.PaddingLeft = UDim.new(0, 10)
	rowPad.PaddingRight = UDim.new(0, 10)
	rowPad.Parent = row

	local function add_dot(order)
		local wrap = Instance.new("Frame")
		wrap.Name = "DotWrap" .. order
		wrap.Parent = row
		wrap.BackgroundTransparency = 1
		wrap.Size = UDim2.new(0, 22, 1, 0)
		wrap.LayoutOrder = order
		local wmLogo = Instance.new("ImageLabel")
		wmLogo.Name = "WmLogo"
		wmLogo.Parent = wrap
		wmLogo.AnchorPoint = Vector2.new(0, 0.5)
		wmLogo.Position = UDim2.new(0, 0, 0.5, 0)
		wmLogo.Size = UDim2.fromOffset(16, 16)
		wmLogo.BackgroundTransparency = 1
		wmLogo.Image = ICONS.Logo
		wmLogo.ScaleType = Enum.ScaleType.Fit
		return wmLogo
	end

	local function add_text(text, color, font, order)
		local lbl = Instance.new("TextLabel")
		lbl.Name = "Item" .. order
		lbl.Parent = row
		lbl.BackgroundTransparency = 1
		lbl.AutomaticSize = Enum.AutomaticSize.X
		lbl.Size = UDim2.new(0, 0, 1, 0)
		lbl.Font = font
		lbl.Text = text
		lbl.TextColor3 = color
		lbl.TextSize = 12
		lbl.LayoutOrder = order
		return lbl
	end

	local function add_sep(order)
		local wrap = Instance.new("Frame")
		wrap.Name = "Sep" .. order
		wrap.Parent = row
		wrap.BackgroundTransparency = 1
		wrap.Size = UDim2.new(0, 14, 1, 0)
		wrap.LayoutOrder = order

		local bar = Instance.new("Frame")
		bar.Name = "Bar"
		bar.Parent = wrap
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(0.5, 0.5)
		bar.Size = UDim2.fromOffset(1, 11)
		bar.BackgroundColor3 = Theme.StrokeLight
		bar.BorderSizePixel = 0
		return wrap
	end

	add_dot(0)
	local lblBrand = add_text("BSMT", Theme.AccentBright, Enum.Font.GothamBold, 1)
	add_sep(2)
	add_text(player.Name, Theme.Text, Enum.Font.GothamMedium, 3)
	add_sep(4)
	local lblFpsVal = add_text("--", Theme.TextBright, Enum.Font.GothamBold, 5)
	add_text(" fps", Theme.TextMuted, Enum.Font.Gotham, 6)
	add_sep(7)
	local lblPingVal = add_text("--", Theme.TextBright, Enum.Font.GothamBold, 8)
	add_text(" ms", Theme.TextMuted, Enum.Font.Gotham, 9)
	add_sep(10)
	local lblTime = add_text("00:00", Theme.TextMuted, Enum.Font.GothamMedium, 11)

	local function sync_wm_width()
		local raw_w = rowLayout.AbsoluteContentSize.X
		local sc = math.max(0.7, scale_factor)
		local unscaled_w = math.round((raw_w / sc) + 22)
		outer.Size = UDim2.fromOffset(math.max(210, unscaled_w), 28)
	end
	rowLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(sync_wm_width)
	task.defer(sync_wm_width)

	local function format_uptime(secs)
		local s = math.floor(secs)
		local h = math.floor(s / 3600)
		local m = math.floor((s % 3600) / 60)
		local sec = s % 60
		return h > 0 and string.format("%d:%02d:%02d", h, m, sec) or string.format("%02d:%02d", m, sec)
	end

	local wmDragging = false
	local wmDragStart = nil
	local wmStartPos = nil

	outer.InputBegan:Connect(function(input)
		if is_primary_input(input) then
			wmDragging = true
			wmDragStart = Vector2.new(input.Position.X, input.Position.Y)
			local vp = cam.ViewportSize
			local sc = math.max(0.7, scale_factor)
			local w = outer.Size.X.Offset * sc
			local h = outer.Size.Y.Offset * sc
			local curX = outer.Position.X.Scale * vp.X + outer.Position.X.Offset - outer.AnchorPoint.X * w
			local curY = outer.Position.Y.Scale * vp.Y + outer.Position.Y.Offset - outer.AnchorPoint.Y * h
			wmStartPos = Vector2.new(curX, curY)
			outer.AnchorPoint = Vector2.new(0, 0)
			outer.Position = UDim2.fromOffset(math.round(curX), math.round(curY))
			outerStroke.Color = Theme.Accent
		end
	end)

	track_conn(uis.InputChanged:Connect(function(input)
		if wmDragging and is_move_input(input) then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - wmDragStart
			local vp = cam.ViewportSize
			local sc = math.max(0.7, scale_factor)
			local w = outer.Size.X.Offset * sc
			local h = outer.Size.Y.Offset * sc
			local nx = math.clamp(wmStartPos.X + delta.X, 6, math.max(6, vp.X - w - 6))
			local ny = math.clamp(wmStartPos.Y + delta.Y, 6, math.max(6, vp.Y - h - 6))
			outer.Position = UDim2.fromOffset(math.round(nx), math.round(ny))
		end
	end))

	track_conn(uis.InputEnded:Connect(function(input)
		if is_primary_input(input) and wmDragging then
			wmDragging = false
			outerStroke.Color = Theme.StrokeLight
		end
	end))

	local function apply_wm_preset(presetName)
		local p = tostring(presetName or "Top Left")
		_G.BSMTConfigData["watermark_position"] = p
		if p == "Top Center" then
			outer.AnchorPoint = Vector2.new(0.5, 0)
			outer.Position = UDim2.new(0.5, 0, 0, 12)
		elseif p == "Top Right" then
			outer.AnchorPoint = Vector2.new(1, 0)
			outer.Position = UDim2.new(1, -14, 0, 12)
		elseif p == "Bottom Left" then
			outer.AnchorPoint = Vector2.new(0, 1)
			outer.Position = UDim2.new(0, 14, 1, -12)
		elseif p == "Bottom Right" then
			outer.AnchorPoint = Vector2.new(1, 1)
			outer.Position = UDim2.new(1, -14, 1, -12)
		else
			outer.AnchorPoint = Vector2.new(0, 0)
			outer.Position = UDim2.new(0, 14, 0, 12)
		end
	end

	local wmConn
	local wmVisible = true
	local frameCount = 0
	local lastFpsTime = tick()
	local pingTimer = 0
	local lastTimeStr = nil

	local function update_watermark(dt)
		local now = tick()
		frameCount += 1
		if now - lastFpsTime >= 0.45 then
			local fps = math.round(frameCount / (now - lastFpsTime))
			frameCount = 0
			lastFpsTime = now
			lblFpsVal.Text = tostring(fps)
		end

		pingTimer += dt
		if pingTimer >= 0.8 then
			pingTimer = 0
			local ok, rawPing = pcall(function()
				return math.round(stats.Network.ServerStatsItem["Data Ping"]:GetValue())
			end)
			if ok and rawPing then
				lblPingVal.Text = tostring(rawPing)
			end
			local uptimeStr = format_uptime(now - scriptStartTime)
			if uptimeStr ~= lastTimeStr then
				lastTimeStr = uptimeStr
				lblTime.Text = uptimeStr
			end
			sync_wm_width()
		end
	end

	local function start_watermark()
		if wmConn then return end
		wmConn = runservice.Heartbeat:Connect(update_watermark)
	end

	local function stop_watermark()
		if wmConn then wmConn:Disconnect() wmConn = nil end
	end

	local function set_watermark_visible(v)
		wmVisible = v
		outer.Visible = v
		_G.BSMTConfigData["watermark_enabled"] = v
		if v then start_watermark() else stop_watermark() end
	end

	parent_protected(screenGui)
	set_watermark_visible(true)

	Library.Watermark = {
		SetVisible = set_watermark_visible,
		IsVisible = function() return wmVisible end,
		SetTitle = function(titleStr)
			if titleStr and titleStr ~= "" then
				lblBrand.Text = tostring(titleStr)
				task.defer(sync_wm_width)
			end
		end,
		SetPositionPreset = apply_wm_preset,
	}
	Library._scriptStartTime = scriptStartTime

	register_config_element("watermark_enabled", {
		Type = "WatermarkToggle",
		Apply = function(_, value)
			set_watermark_visible(value == true or value == nil)
		end,
	})
	if _G.BSMTConfigData["watermark_enabled"] ~= nil then
		set_watermark_visible(_G.BSMTConfigData["watermark_enabled"])
	end
	if _G.BSMTConfigData["watermark_position"] then
		apply_wm_preset(_G.BSMTConfigData["watermark_position"])
	end
end

function Library.SetTheme(overrides)
	if type(overrides) ~= "table" then return end
	local oldVals = {}
	for k in pairs(overrides) do oldVals[k] = Theme[k] end
	for k, v in pairs(overrides) do Theme[k] = v end
	Library.Settings.Theme = Theme

	local function remap(cur)
		if not cur then return nil end
		for k, old in pairs(oldVals) do
			if old and cur == old then return Theme[k] end
		end
		return nil
	end

	local roots = {}
	pcall(function() table.insert(roots, (gethui and gethui()) or coregui) end)
	pcall(function() table.insert(roots, player:FindFirstChild("PlayerGui")) end)

	local props = { "BackgroundColor3", "TextColor3", "ImageColor3", "PlaceholderColor3" }
	for _, root in ipairs(roots) do
		if root then
			for _, guiName in ipairs({ "BSMT", "BSMTNotifications", "BSMTWatermark", "ToggleGui_BSMT" }) do
				local g = root:FindFirstChild(guiName)
				if g then
					for _, d in ipairs(g:GetDescendants()) do
						for _, prop in ipairs(props) do
							local ok, cur = pcall(function() return d[prop] end)
							if ok then
								local nv = remap(cur)
								if nv then pcall(function() d[prop] = nv end) end
							end
						end
						if d:IsA("UIStroke") then
							local nv = remap(d.Color)
							if nv then d.Color = nv end
						elseif d:IsA("UIGradient") then
							local changed, newKp = false, {}
							for _, point in ipairs(d.Color.Keypoints) do
								local nv = remap(point.Value)
								if nv then
									changed = true
									table.insert(newKp, ColorSequenceKeypoint.new(point.Time, nv))
								else
									table.insert(newKp, point)
								end
							end
							if changed then pcall(function() d.Color = ColorSequence.new(newKp) end) end
						end
					end
				end
			end
		end
	end
end

function Library.Unload()
	if Library.Watermark then pcall(Library.Watermark.SetVisible, false) end
	library_alive = false
	table.clear(slow_tick_listeners)
	table.clear(window_resize_listeners)
	table.clear(genv_watchers)
	table.clear(keybind_registry)
	if _G.BSMTConfigElements then table.clear(_G.BSMTConfigElements) end
	keybind_dispatch = nil

	for conn in pairs(live_connections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(live_connections)

	local containers = {}
	pcall(function() table.insert(containers, (gethui and gethui()) or coregui) end)
	pcall(function() table.insert(containers, player:FindFirstChild("PlayerGui")) end)

	for _, container in ipairs(containers) do
		if container then
			for _, name in ipairs({ "BSMT", "BSMTNotifications", "BSMTWatermark", "ToggleGui_BSMT" }) do
				local g = container:FindFirstChild(name)
				if g then pcall(function() g:Destroy() end) end
			end
		end
	end
end

return Library
