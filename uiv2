function elementHandler:Dropdown(dropdownName, optionsOrCallback, callbackOrFlag, flagArg)
	restore_id()
	local dropdown = setmetatable({}, dropdownHandler)
	local dropdownInstance = original_elements.Dropdown:Clone()
	local elementHolderInner = dropdownInstance.ElementHolder.ElementHolderBackground.ElementHolderInnerBackground
	local listLayout = elementHolderInner.ElementHolderInnerBackgroundList
	local listPaddings = 8
	local maxListHeight = 148

	local options = type(optionsOrCallback) == "table" and optionsOrCallback or nil
	local callback = type(optionsOrCallback) == "function" and optionsOrCallback or (type(callbackOrFlag) == "function" and callbackOrFlag or nil)
	local flag = type(callbackOrFlag) == "string" and callbackOrFlag or flagArg

	local prefix_str, init_val = nil, nil
	if type(dropdownName) == "string" then
		local p, v = dropdownName:match("^([^:]+:%s*)(.+)$")
		if p and v then
			prefix_str = p
			init_val = v
		end
	end

	local syncKey = resolve_sync_flag(flag, dropdownName, callback)
	local dropBtnStroke = dropdownInstance.DropdownButton:FindFirstChildWhichIsA("UIStroke")

	local imgOpenTween = tweenservice:Create(dropdownInstance.DropdownButton.ButtonBackground.DropdownImage, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Rotation = 180, ImageColor3 = Theme.AccentBright })
	local imgCloseTween = tweenservice:Create(dropdownInstance.DropdownButton.ButtonBackground.DropdownImage, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Rotation = 0, ImageColor3 = Theme.TextMuted })
	local closeTween = tweenservice:Create(dropdownInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, M.ElementH) })

	local function apply_split_label(inst, rawStr)
		local btnBg = inst.DropdownButton.ButtonBackground
		local dTxt = btnBg.DropdownText
		local vPill = btnBg:FindFirstChild("ValuePill")
		local lblPart, valPart = tostring(rawStr or "N/A"):match("^([^:]+):%s*(.+)$")
		if vPill and lblPart and valPart and valPart ~= "" then
			dTxt.Text = lblPart
			dTxt.Size = UDim2.new(0.54, -4, 1, 0)
			vPill.Visible = true
			if vPill:FindFirstChild("ValueText") then
				vPill.ValueText.Text = valPart
			end
		else
			dTxt.Text = tostring(rawStr or "N/A")
			if vPill and dropdown and dropdown.Selected ~= nil and tostring(dropdown.Selected) ~= "" then
				dTxt.Size = UDim2.new(0.54, -4, 1, 0)
				vPill.Visible = true
				if vPill:FindFirstChild("ValueText") then
					vPill.ValueText.Text = tostring(dropdown.Selected)
				end
			else
				dTxt.Size = UDim2.new(1, -28, 1, 0)
				if vPill then vPill.Visible = false end
			end
		end
	end

	local function get_open_heights()
		local raw_h = listLayout.AbsoluteContentSize.Y + listPaddings
		local clamped_h = math.min(maxListHeight, raw_h)
		return raw_h, clamped_h
	end

	local function update_open_size(animate)
		local raw_h, clamped_h = get_open_heights()
		dropdownInstance.ElementHolder.CanvasSize = UDim2.new(0, 0, 0, raw_h)
		local total_h = clamped_h > listPaddings and (M.ElementH + 3 + clamped_h) or M.ElementH
		if dropdown.IsExpanded then
			if animate then
				tweenservice:Create(dropdownInstance.ElementHolder, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, -2, 0, clamped_h) }):Play()
				tweenservice:Create(dropdownInstance, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, total_h) }):Play()
			else
				dropdownInstance.ElementHolder.Size = UDim2.new(1, -2, 0, clamped_h)
				dropdownInstance.Size = UDim2.new(1, 0, 0, total_h)
			end
		else
			dropdownInstance.ElementHolder.Size = UDim2.new(1, -2, 0, clamped_h)
		end
	end

	local function collapse_dropdown()
		if not dropdown.IsExpanded then return end
		dropdown.IsExpanded = false
		if dropBtnStroke then dropBtnStroke.Color = Theme.StrokeLight end
		imgCloseTween:Play()
		closeTween:Play()
	end

	local function toggle_dropdown()
		if dropdown.IsExpanded then
			collapse_dropdown()
		else
			dropdown.IsExpanded = true
			if dropBtnStroke then dropBtnStroke.Color = Theme.Accent end
			imgOpenTween:Play()
			update_open_size(true)
		end
	end

	dropdown.Type = "Dropdown"
	dropdown.IdentifierText = dropdownName or "N/A"
	dropdown.BaseTitle = dropdownName or "Dropdown"
	dropdown.Prefix = prefix_str
	dropdown.Instance = dropdownInstance
	dropdown.GuiToRemove = dropdownInstance
	dropdown.ElementToParentChildren = elementHolderInner
	dropdown.IsExpanded = false
	dropdown.Selected = init_val
	dropdown.Callback = callback
	dropdown.Flag = syncKey
	dropdown.ConfigIdentifier = syncKey or dropdownName or "Dropdown"
	dropdown._optionCallbacks = {}
	dropdown._optionButtons = {}
	dropdown._collapse = collapse_dropdown
	dropdown._applying = false

	register_config_element(dropdown.ConfigIdentifier, dropdown)

	if self.Type == "SearchBar" then
		self.ChildedElementsInfo[dropdownInstance] = dropdown
	end

	dropdownInstance.DropdownButton.Activated:Connect(toggle_dropdown)
	listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		update_open_size(true)
	end)

	apply_split_label(dropdownInstance, dropdownName or "N/A")
	dropdownInstance.Parent = self.ElementToParentChildren

	function dropdown:_bindFlag(newFlag)
		if not newFlag or newFlag == "" or self._boundWatchedFlag == newFlag then return end
		if self.ConfigIdentifier and self.ConfigIdentifier ~= newFlag then
			unregister_config_element(self.ConfigIdentifier, self)
		end
		self.Flag = newFlag
		self.ConfigIdentifier = newFlag
		self._boundWatchedFlag = newFlag
		register_config_element(newFlag, self)
		local curG = read_flag_val(newFlag)
		if curG ~= nil then
			self.Selected = curG
			_G.BSMTConfigData[newFlag] = curG
			if self.Prefix then
				self:ChangeText(self.Prefix .. tostring(curG))
			end
		end
		watch_genv(newFlag, function(v)
			if v ~= nil and tostring(v) ~= tostring(self.Selected) and not self._applying then
				self:Set(v, false)
			end
		end)
	end

	if syncKey and (synced_flags[syncKey] or flag ~= nil or read_flag_val(syncKey) ~= nil) then
		dropdown:_bindFlag(syncKey)
	end

	if options then
		dropdown:SetOptions(options)
	end

	local start_val = read_flag_val(dropdown.Flag)
	if start_val == nil then start_val = _G.BSMTConfigData[dropdown.ConfigIdentifier] end
	if start_val ~= nil then
		dropdown:Set(start_val, false)
	end

	task.defer(function()
		if not dropdownInstance.Parent then return end
		local def_val = read_flag_val(dropdown.Flag)
		if def_val ~= nil and tostring(def_val) ~= tostring(dropdown.Selected) then
			dropdown:Set(def_val, false)
		elseif dropdown.Selected ~= nil then
			dropdown:_highlightOption(dropdown.Selected)
		end
	end)

	return dropdown
end

function dropdownHandler:_highlightOption(selectedVal)
	if not self._optionButtons then return end
	local selStr = tostring(selectedVal or "")
	for optKey, btn in pairs(self._optionButtons) do
		if btn and btn.Instance and btn.Instance.Parent then
			local bg = btn.Instance:FindFirstChild("ButtonBg")
			local txt = bg and bg:FindFirstChild("ButtonText")
			local strk = bg and bg:FindFirstChildWhichIsA("UIStroke")
			local optAcc = bg and bg:FindFirstChild("OptionAccent")
			local isSel = (optKey == selStr)
			if bg then
				bg.BackgroundColor3 = isSel and Theme.Element or Theme.Element
				bg.BackgroundTransparency = isSel and 0.08 or 1
			end
			if txt then
				txt.TextColor3 = isSel and Theme.AccentBright or Theme.TextMuted
				txt.Font = isSel and Enum.Font.GothamBold or Enum.Font.Gotham
			end
			if strk then
				strk.Color = Theme.Accent
				strk.Transparency = isSel and 0.65 or 1
			end
			if optAcc then optAcc.Visible = isSel end
		end
	end
end

function dropdownHandler:ChangeText(newText)
	restore_id()
	newText = newText or "N/A"
	self.IdentifierText = newText
	local btnBg = self.Instance.DropdownButton.ButtonBackground
	local dTxt = btnBg.DropdownText
	local vPill = btnBg:FindFirstChild("ValuePill")
	local lblPart, valPart = tostring(newText):match("^([^:]+):%s*(.+)$")
	if vPill and lblPart and valPart and valPart ~= "" then
		dTxt.Text = lblPart
		dTxt.Size = UDim2.new(0.54, -4, 1, 0)
		vPill.Visible = true
		if vPill:FindFirstChild("ValueText") then
			vPill.ValueText.Text = valPart
		end
	else
		dTxt.Text = tostring(newText)
		if vPill and self.Selected ~= nil and tostring(self.Selected) ~= "" then
			dTxt.Size = UDim2.new(0.54, -4, 1, 0)
			vPill.Visible = true
			if vPill:FindFirstChild("ValueText") then
				vPill.ValueText.Text = tostring(self.Selected)
			end
		else
			dTxt.Size = UDim2.new(1, -28, 1, 0)
			if vPill then vPill.Visible = false end
		end
	end
	if self.Prefix and newText:sub(1, #self.Prefix) == self.Prefix then
		local extracted = newText:sub(#self.Prefix + 1)
		if extracted ~= "" then
			self.Selected = extracted
			self:_highlightOption(extracted)
		end
	end
end

function dropdownHandler:Button(optName, callback)
	restore_id()
	local optStr = tostring(optName or "Option")
	self._optionCallbacks = self._optionCallbacks or {}
	self._optionButtons = self._optionButtons or {}

	if not self._boundWatchedFlag and type(callback) == "function" then
		local inferred = infer_flag_from_cb(callback)
		if inferred then
			self:_bindFlag(inferred)
		end
	end

	self._optionCallbacks[optStr] = callback

	local btn = elementHandler.Button(self, optStr, function()
		restore_id()
		self._applying = true
		self.Selected = optName
		if self.Prefix then
			self:ChangeText(self.Prefix .. optStr)
		else
			local vPill = self.Instance.DropdownButton.ButtonBackground:FindFirstChild("ValuePill")
			if vPill and vPill:FindFirstChild("ValueText") then
				vPill.ValueText.Text = optStr
				vPill.Visible = true
				self.Instance.DropdownButton.ButtonBackground.DropdownText.Size = UDim2.new(0.54, -4, 1, 0)
			end
		end
		if callback then
			pcall(callback, optName)
		end
		if self.Callback and self.Callback ~= callback then
			pcall(self.Callback, optName)
		end
		_G.BSMTConfigData[self.ConfigIdentifier] = optName
		if self.Flag and (synced_flags[self.Flag] or read_flag_val(self.Flag) ~= nil) then
			write_flag_val(self.Flag, optName)
		end
		self:_highlightOption(optName)
		if self._collapse then self._collapse() end
		self._applying = false
	end)

	local inst = btn.Instance
	inst.Size = UDim2.new(1, 0, 0, 24)
	local bg = inst:FindFirstChild("ButtonBg")
	if bg then
		bg.BackgroundTransparency = 1
		local c = bg:FindFirstChildWhichIsA("UICorner")
		if c then c.CornerRadius = UDim.new(0, 5) end
		local st = bg:FindFirstChildWhichIsA("UIStroke")
		if st then st.Transparency = 1 end
		local optAcc = bg:FindFirstChild("OptionAccent")
		if optAcc then
			optAcc.Position = UDim2.new(0, 4, 0.5, 0)
			optAcc.Size = UDim2.new(0, 2.5, 0, 12)
		end
		local txt = bg:FindFirstChild("ButtonText")
		if txt then
			txt.Position = UDim2.new(0, 13, 0, 0)
			txt.Size = UDim2.new(1, -18, 1, 0)
			txt.TextXAlignment = Enum.TextXAlignment.Left
			txt.Font = Enum.Font.Gotham
			txt.TextColor3 = Theme.TextMuted
			txt.TextSize = M.TextSizeSm
		end
		inst.MouseEnter:Connect(function()
			if tostring(self.Selected) ~= optStr then
				bg.BackgroundTransparency = 0.5
				if txt then txt.TextColor3 = Theme.TextBright end
			end
		end)
		inst.MouseLeave:Connect(function()
			if tostring(self.Selected) ~= optStr then
				bg.BackgroundTransparency = 1
				if txt then txt.TextColor3 = Theme.TextMuted end
			end
		end)
	end

	self._optionButtons[optStr] = btn
	if self.Selected ~= nil and tostring(self.Selected) == optStr then
		self:_highlightOption(self.Selected)
	end
	return btn
end

function dropdownHandler:Set(val, fireCallback)
	restore_id()
	self._applying = true
	self.Selected = val
	local valStr = tostring(val)
	if self.Prefix and valStr:sub(1, #self.Prefix) ~= self.Prefix then
		self:ChangeText(self.Prefix .. valStr)
	else
		self:ChangeText(valStr)
	end
	self:_highlightOption(val)
	_G.BSMTConfigData[self.ConfigIdentifier] = val
	if self.Flag and (synced_flags[self.Flag] or read_flag_val(self.Flag) ~= nil) then
		write_flag_val(self.Flag, val)
	end
	if fireCallback ~= false then
		if self.Callback then
			pcall(self.Callback, val)
		elseif self._optionCallbacks and self._optionCallbacks[valStr] then
			pcall(self._optionCallbacks[valStr], val)
		end
	end
	self._applying = false
end

function dropdownHandler:Clear()
	restore_id()
	if self._optionCallbacks then table.clear(self._optionCallbacks) end
	if self._optionButtons then table.clear(self._optionButtons) end
	for _, ch in ipairs(self.ElementToParentChildren:GetChildren()) do
		if ch:IsA("GuiObject") then ch:Destroy() end
	end
end

function dropdownHandler:SetOptions(list)
	self:Clear()
	for _, opt in ipairs(list or {}) do
		self:Button(tostring(opt), function()
			self:Set(opt, true)
		end)
	end
end

function elementHandler:Slider(sliderName, callback, maximumValue, minimumValue, flag)
	restore_id()
	local slider = setmetatable({}, sliderHandler)
	local sliderInstance = original_elements.Slider:Clone()
	local isDragging = false
	local sliderBar = sliderInstance.SliderBackground.SliderInnerBackground.Slider

	minimumValue = minimumValue or 0
	maximumValue = maximumValue or 100
	if maximumValue == minimumValue then maximumValue = minimumValue + 1 end
	if maximumValue < minimumValue then minimumValue, maximumValue = maximumValue, minimumValue end

	local maxMinRange = math.abs(minimumValue - maximumValue)
	local sliderValue = minimumValue
	callback = callback or function() end

	local syncKey = resolve_sync_flag(flag, sliderName, callback) or sliderName or "N/A"
	local lastRoundedValue = nil

	local function render_value(v)
		local pct = math.clamp((v - slider._minValue) / (slider._maxValue - slider._minValue), 0, 1)
		sliderBar.Size = UDim2.new(pct, 0, 1, 0)
		sliderInstance.TextGrouping.NumberText.Text = tostring(math.round(v))
	end

	local function apply_from_x(px)
		local track = sliderBar.Parent.EmptySliderBackground
		local absPos = track.AbsolutePosition
		local absSize = track.AbsoluteSize
		if absSize.X <= 0 then return end

		local pct = math.clamp((px - absPos.X) / absSize.X, 0, 1)
		sliderValue = minimumValue + (maxMinRange * pct)
		slider._currentValue = sliderValue
		sliderBar.Size = UDim2.new(pct, 0, 1, 0)

		local rounded = math.round(sliderValue)
		if rounded == lastRoundedValue then return end
		lastRoundedValue = rounded

		sliderInstance.TextGrouping.NumberText.Text = tostring(rounded)
		_G.BSMTConfigData[slider.ConfigIdentifier] = rounded
		write_flag_val(syncKey, rounded)
		callback(rounded)
	end

	sliderInstance.SliderBackground.InputBegan:Connect(function(input)
		if is_primary_input(input) then
			isDragging = true
			set_scroll_lock(sliderInstance, true)
			apply_from_x(input.Position.X)
		end
	end)

	track_conn(uis.InputChanged:Connect(function(input)
		if isDragging and is_move_input(input) then
			apply_from_x(input.Position.X)
		end
	end))

	track_conn(uis.InputEnded:Connect(function(input)
		if isDragging and is_primary_input(input) then
			isDragging = false
			set_scroll_lock(sliderInstance, false)
		end
	end))

	sliderInstance.TextGrouping.NumberText.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			local num = tonumber(sliderInstance.TextGrouping.NumberText.Text)
			if num then
				slider:SetValue(num, true)
			else
				sliderInstance.TextGrouping.NumberText.Text = tostring(math.round(sliderValue))
			end
		else
			sliderInstance.TextGrouping.NumberText.Text = tostring(math.round(sliderValue))
		end
	end)

	slider.Type = "Slider"
	slider.IdentifierText = sliderName or "N/A"
	slider.Instance = sliderInstance
	slider.GuiToRemove = sliderInstance
	slider._minValue = minimumValue
	slider._maxValue = maximumValue
	slider._currentValue = minimumValue
	slider.Flag = syncKey
	slider.ConfigIdentifier = syncKey

	register_config_element(slider.ConfigIdentifier, slider)

	if self.Type == "SearchBar" then
		self.ChildedElementsInfo[sliderInstance] = slider
	end

	local extVal = read_flag_val(syncKey)
	if tonumber(extVal) ~= nil then
		slider._currentValue = math.clamp(tonumber(extVal), minimumValue, maximumValue)
	elseif tonumber(_G.BSMTConfigData[syncKey]) ~= nil then
		slider._currentValue = math.clamp(tonumber(_G.BSMTConfigData[syncKey]), minimumValue, maximumValue)
	end

	sliderValue = slider._currentValue
	lastRoundedValue = math.round(slider._currentValue)
	_G.BSMTConfigData[syncKey] = slider._currentValue
	if flag or synced_flags[syncKey] or read_flag_val(syncKey) ~= nil then
		write_flag_val(syncKey, slider._currentValue)
	end

	function slider:SetValue(v, fireCb)
		restore_id()
		local num = tonumber(v)
		if not num then return end
		num = math.clamp(num, self._minValue, self._maxValue)
		self._currentValue = num
		sliderValue = num
		lastRoundedValue = math.round(num)
		render_value(num)
		_G.BSMTConfigData[self.ConfigIdentifier] = num
		write_flag_val(self.Flag, num)
		if fireCb ~= false then callback(num) end
	end

	watch_genv(syncKey, function(v)
		local num = tonumber(v)
		if num and math.round(num) ~= math.round(slider._currentValue) then
			slider:SetValue(num, false)
		end
	end, function() return isDragging end)

	sliderInstance.TextGrouping.SliderText.Text = sliderName or "N/A"
	render_value(slider._currentValue)
	sliderInstance.Parent = self.ElementToParentChildren

	task.defer(function()
		local deferredVal = tonumber(read_flag_val(syncKey))
		if deferredVal ~= nil then
			slider._currentValue = math.clamp(deferredVal, minimumValue, maximumValue)
			sliderValue = slider._currentValue
			lastRoundedValue = math.round(slider._currentValue)
		end
		render_value(slider._currentValue)
	end)

	return slider
end

function elementHandler:SearchBar(placeholderText)
	local searchBar = setmetatable({}, searchBarHandler)
	local searchBarInstance = original_elements.SearchBar:Clone()
	local searchBox = searchBarInstance.SearchBarFrame.ButtonBackgroundPadding.SearchBox
	local elementHolder = searchBarInstance.ElementHolder
	local elementHolderInner = elementHolder.ElementHolderBackground.ElementHolderInnerBackground
	local listPaddings = 10
	local closeTween = tweenservice:Create(searchBarInstance, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, M.ElementH) })
	local openTween
	local isMouseHovering = false
	local mouseEnterConn, mouseLeaveConn, uisFocusLost
	local playingAnimation, searchingText

	placeholderText = placeholderText or "Search..."

	local function on_text_changed()
		if searchBar.IsExpanded then
			if searchingText then coroutine.close(searchingText) end
			searchingText = coroutine.create(function()
				for _, found in ipairs(elementHolderInner:GetChildren()) do
					local info = searchBar.ChildedElementsInfo[found]
					if info ~= nil then
						found.Visible = info.IdentifierText:lower():find(searchBox.Text:lower(), 1, true) ~= nil
					end
				end
				searchingText = nil
			end)
			coroutine.resume(searchingText)
		end
	end

	local function collapse_search()
		searchBar.IsExpanded = false
		closeTween:Play()
		if mouseLeaveConn then mouseLeaveConn:Disconnect() end
		if mouseEnterConn then mouseEnterConn:Disconnect() end
		if uisFocusLost then uisFocusLost:Disconnect() end

		closeTween.Completed:Once(function(state)
			if state == Enum.PlaybackState.Completed then
				elementHolderInner.Visible = false
			end
		end)

		if playingAnimation then coroutine.close(playingAnimation) end
		playingAnimation = coroutine.create(function()
			searchBox.PlaceholderText = ""
			animate_text(searchBox, 0.02, nil, placeholderText, true)
			playingAnimation = nil
		end)
		coroutine.resume(playingAnimation)
	end

	local function on_focused()
		elementHolderInner.Visible = true
		searchBar.IsExpanded = true
		on_text_changed()
		isMouseHovering = true
		if openTween then openTween:Play() end

		if playingAnimation then
			coroutine.close(playingAnimation)
			searchBox.PlaceholderText = placeholderText
			searchBox.Text = ""
		end

		mouseLeaveConn = searchBarInstance.MouseLeave:Connect(function()
			isMouseHovering = false
			if not searchBox:IsFocused() then collapse_search() end
		end)

		mouseEnterConn = searchBarInstance.MouseEnter:Connect(function()
			isMouseHovering = true
		end)

		uisFocusLost = uis.TextBoxFocusReleased:Connect(function(released)
			if released == searchBox and not isMouseHovering then
				collapse_search()
			end
		end)
	end

	searchBar.Type = "SearchBar"
	searchBar.IdentifierText = placeholderText
	searchBar.Instance = searchBarInstance
	searchBar.GuiToRemove = searchBarInstance
	searchBar.ElementToParentChildren = elementHolderInner
	searchBar.ChildedElementsInfo = {}
	searchBar.IsExpanded = false

	if self.Type == "SearchBar" then
		self.ChildedElementsInfo[searchBarInstance] = searchBar
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(on_text_changed)
	searchBox.Focused:Connect(on_focused)

	elementHolderInner.ElementHolderInnerBackgroundList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		local content_y = elementHolderInner.ElementHolderInnerBackgroundList.AbsoluteContentSize.Y
		local h = content_y > 0 and (content_y + listPaddings) or 0
		if searchBar.IsExpanded then
			tweenservice:Create(elementHolder, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, h) }):Play()
			openTween = tweenservice:Create(searchBarInstance, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, M.ElementH + (h > 0 and h + 4 or 0)) })
			openTween:Play()
		else
			elementHolder.Size = UDim2.new(1, 0, 0, h)
			openTween = tweenservice:Create(searchBarInstance, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, M.ElementH + (h > 0 and h + 4 or 0)) })
		end
	end)

	searchBox.PlaceholderText = placeholderText
	searchBarInstance.Parent = self.ElementToParentChildren
	openTween = tweenservice:Create(searchBarInstance, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, M.ElementH) })

	return searchBar
end

function elementHandler:Keybind(keybindName, callback, defaultKey, flag)
	restore_id()
	local keybind = setmetatable({}, keybindHandler)
	local inst = original_elements.Keybind:Clone()
	local tag = inst.BoxBackground
	local keyLabel = tag.KeyText
	local nameLabel = inst.KeybindText
	local isListening = false
	local currentBinding = nil

	callback = callback or function() end
	keybindName = keybindName or "Keybind"
	defaultKey = defaultKey or ""

	keybind.Type = "Keybind"
	keybind.IdentifierText = keybindName
	keybind.Instance = inst
	keybind.GuiToRemove = inst
	keybind.Flag = flag
	keybind.ConfigIdentifier = flag or (keybindName .. "_bind")

	local function apply_tag_style(listening)
		if listening then
			keyLabel.Text = "..."
			keyLabel.TextColor3 = Theme.Accent
			if tag:FindFirstChild("TagBorder") then tag.TagBorder.Color = Theme.Accent end
		else
			keyLabel.TextColor3 = currentBinding and Theme.Text or Theme.TextMuted
			if tag:FindFirstChild("TagBorder") then tag.TagBorder.Color = Theme.Stroke end
		end
	end

	local function set_display(dispName)
		keyLabel.Text = dispName or "None"
		apply_tag_style(false)
	end

	function keybind:SetBinding(binding, dispName)
		restore_id()
		currentBinding = binding
		set_display(dispName)
		_G.BSMTConfigData[self.ConfigIdentifier] = encode_binding(binding)
	end

	local listenConn
	local function begin_listening()
		if isListening then return end
		isListening = true
		apply_tag_style(true)
		if listenConn then listenConn:Disconnect() end
		listenConn = uis.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape then
				listenConn:Disconnect()
				listenConn = nil
				keybind:SetBinding(nil, nil)
				task.defer(function() isListening = false end)
				return
			end
			local dispName, binding = resolve_binding(input)
			if not binding then return end
			listenConn:Disconnect()
			listenConn = nil
			keybind:SetBinding(binding, dispName)
			task.defer(function() isListening = false end)
		end)
	end

	local keybindEntry = register_keybind({
		isListening = function() return isListening end,
		getBinding = function() return currentBinding end,
		callback = function() callback() end,
	})

	local touchHoldToken = 0
	inst.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			touchHoldToken += 1
			local myToken = touchHoldToken
			task.delay(0.45, function()
				if touchHoldToken == myToken then
					if listenConn then listenConn:Disconnect() listenConn = nil end
					isListening = false
					keybind:SetBinding(nil, nil)
				end
			end)
		end
	end)
	inst.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			touchHoldToken += 1
		end
	end)

	inst.Activated:Connect(begin_listening)
	inst.MouseButton2Click:Connect(function()
		if listenConn then listenConn:Disconnect() listenConn = nil end
		isListening = false
		keybind:SetBinding(nil, nil)
	end)

	local saved = _G.BSMTConfigData[keybind.ConfigIdentifier]
	if saved and saved ~= "" then
		local disp, bind = decode_binding(saved)
		if bind then
			currentBinding = bind
			set_display(disp)
		end
	elseif defaultKey ~= "" then
		local disp, bind = decode_binding(defaultKey)
		if bind then
			currentBinding = bind
			set_display(disp)
		end
	end

	if not currentBinding then set_display(nil) end
	register_config_element(keybind.ConfigIdentifier, keybind)

	nameLabel.Text = keybindName
	inst.Parent = self.ElementToParentChildren
	if tag:FindFirstChild("BoxAspect") then tag.BoxAspect:Destroy() end

	function keybind:Remove()
		unregister_keybind(keybindEntry)
		unregister_config_element(self.ConfigIdentifier, self)
		if listenConn then listenConn:Disconnect() listenConn = nil end
		self.GuiToRemove:Destroy()
	end

	return keybind
end

