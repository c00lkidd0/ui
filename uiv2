function Library.new(windowName, constrainToScreen, width, height, visibilityKeybind)
	library_alive = true
	local window = setmetatable({}, windowHandler)
	local windowInstance = original_elements.Window:Clone()
	local background = windowInstance.Background
	local heading = background.Heading
	local buttonHolder = heading.ButtonHolder
	local holder = background.Holder

	window.IsHidden = false
	window.TabInfo = {}
	window.Type = "Window"
	window.Instance = windowInstance
	window.GuiToRemove = windowInstance
	window.isConstraintedToScreenBoundaries = constrainToScreen == nil and true or constrainToScreen
	window.IsMinimized = false

	local function get_keycode_from_name(name)
		if not name then return end
		for _, kc in pairs(Enum.KeyCode:GetEnumItems()) do
			if kc.Name:lower() == name:lower() then
				return kc
			end
		end
	end

	window.CurrentKeybind = get_keycode_from_name(visibilityKeybind) or Enum.KeyCode.RightShift
	heading.Title.Text = windowName or "BSMT"
	parent_protected(windowInstance)

	local cur_vp = cam.ViewportSize
	local w_px = width or (is_mobile and math.clamp(math.round(cur_vp.X * 0.86), 440, 680) or 660)
	local h_px = height or (is_mobile and math.clamp(math.round(cur_vp.Y * 0.80), 300, 460) or 440)
	w_px = math.min(w_px, cur_vp.X - 16)
	h_px = math.min(h_px, cur_vp.Y - 16)

	background.Size = UDim2.fromOffset(w_px, h_px)
	background.Position = UDim2.fromOffset(math.round(cur_vp.X / 2), math.round(cur_vp.Y / 2))

	local original_window_size = Vector2.new(w_px, h_px)
	local min_long_size = Vector2.new(w_px, 38)
	local min_short_size = Vector2.new(math.max(180, math.round(w_px * 0.35)), 38)

	local dragging = false
	local drag_input = nil
	local drag_start_pos = nil
	local win_start_pos = nil

	heading.InputBegan:Connect(function(input)
		if is_primary_input(input) then
			dragging = true
			drag_input = input
			drag_start_pos = Vector2.new(input.Position.X, input.Position.Y)
			win_start_pos = Vector2.new(background.Position.X.Offset, background.Position.Y.Offset)
		end
	end)

	heading.InputChanged:Connect(function(input)
		if is_move_input(input) then
			drag_input = input
		end
	end)

	track_conn(uis.InputChanged:Connect(function(input)
		if dragging and (input == drag_input or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - drag_start_pos
			local vp = cam.ViewportSize
			local abs_sz = background.AbsoluteSize
			local nx = win_start_pos.X + delta.X
			local ny = win_start_pos.Y + delta.Y
			if window.isConstraintedToScreenBoundaries then
				nx = math.clamp(nx, abs_sz.X / 2, vp.X - abs_sz.X / 2)
				ny = math.clamp(ny, abs_sz.Y / 2, vp.Y - abs_sz.Y / 2)
			end
			background.Position = UDim2.fromOffset(nx, ny)
		end
	end))

	track_conn(uis.InputEnded:Connect(function(input)
		if is_primary_input(input) then
			dragging = false
			drag_input = nil
		end
	end))

	track_conn(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		local vp = cam.ViewportSize
		local abs_sz = background.AbsoluteSize
		local nx = math.clamp(background.Position.X.Offset, abs_sz.X / 2, vp.X - abs_sz.X / 2)
		local ny = math.clamp(background.Position.Y.Offset, abs_sz.Y / 2, vp.Y - abs_sz.Y / 2)
		background.Position = UDim2.fromOffset(nx, ny)
	end))

	local function close_window()
		local tw = tweenservice:Create(background, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Size = UDim2.fromOffset(0, 0) })
		tw.Completed:Connect(function()
			if window and window._visibilityConn then
				window._visibilityConn:Disconnect()
				window._visibilityConn = nil
			end
			windowInstance:Destroy()
			window = nil
		end)
		tw:Play()
	end

	local function minimize_window()
		window.IsMinimized = true
		holder.Visible = false
		local tw_up = tweenservice:Create(background, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(min_long_size.X, min_long_size.Y)
		})
		local tw_minus = tweenservice:Create(buttonHolder.Minus, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Rotation = 180, ImageTransparency = 1 })
		local tw_plus = tweenservice:Create(buttonHolder.Plus, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Rotation = 0, ImageTransparency = 0 })

		tw_up.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed then
				tweenservice:Create(background, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.fromOffset(min_short_size.X, min_short_size.Y)
				}):Play()
			end
		end)

		tw_minus.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed then
				buttonHolder.Minus.Visible = false
				buttonHolder.Plus.Visible = true
				tw_plus:Play()
			end
		end)

		tw_up:Play()
		tw_minus:Play()
	end

	local function maximize_window()
		window.IsMinimized = false
		local tw_right = tweenservice:Create(background, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(min_long_size.X, min_long_size.Y)
		})
		local tw_plus = tweenservice:Create(buttonHolder.Plus, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Rotation = 180, ImageTransparency = 1 })
		local tw_minus = tweenservice:Create(buttonHolder.Minus, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Rotation = 0, ImageTransparency = 0 })

		tw_right.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed then
				holder.Visible = true
				local tw_down = tweenservice:Create(background, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Size = UDim2.fromOffset(original_window_size.X, original_window_size.Y)
				})
				buttonHolder.Plus.Visible = false
				buttonHolder.Minus.Visible = true
				tw_down:Play()
				tw_minus:Play()
			end
		end)

		tw_right:Play()
		tw_plus:Play()
	end

	buttonHolder.Close.Activated:Connect(close_window)
	buttonHolder.Plus.Activated:Connect(maximize_window)
	buttonHolder.Minus.Activated:Connect(minimize_window)

	window._visibilityConn = track_conn(uis.InputBegan:Connect(function(input, gp)
		if gp then return end
		if not background or not background.Parent then
			if window and window._visibilityConn then
				window._visibilityConn:Disconnect()
				window._visibilityConn = nil
			end
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == window.CurrentKeybind then
			background.Visible = not background.Visible
		end
	end))

	auto_canvas_size(holder.Tabs, holder.Tabs.TabsUIListLayout, 20)

	if is_mobile then
		window:CreateMobileButton(nil, true)
	end

	return window
end

