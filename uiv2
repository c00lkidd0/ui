local function animate_text(text_inst, speed, text, placeholder, fill_ph, empty_ph)
	if empty_ph then
		for i = #text_inst.PlaceholderText, 0, -1 do
			text_inst.PlaceholderText = text_inst.PlaceholderText:sub(1, i)
			task.wait(speed)
		end
	else
		for i = #text_inst.Text, 0, -1 do
			text_inst.Text = text_inst.Text:sub(1, i)
			task.wait(speed)
		end
	end
	if fill_ph then
		for i = 1, #placeholder do
			text_inst.PlaceholderText = placeholder:sub(1, i)
			task.wait(speed)
		end
	else
		for i = 1, #text do
			text_inst.Text = text:sub(1, i)
			task.wait(speed)
		end
	end
end

local function to_polar(v)
	return v.Magnitude, math.atan2(v.Y, v.X)
end

local function parse_color(v)
	if typeof(v) == "Color3" then
		return v
	elseif type(v) == "table" and #v >= 3 then
		local r, g, b = tonumber(v[1]) or 255, tonumber(v[2]) or 255, tonumber(v[3]) or 255
		if r <= 1 and g <= 1 and b <= 1 and (r % 1 ~= 0 or g % 1 ~= 0 or b % 1 ~= 0) then
			return Color3.new(r, g, b)
		end
		return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
	elseif type(v) == "string" then
		local hex = v:gsub("#", "")
		if #hex == 6 then
			local r = tonumber(hex:sub(1, 2), 16)
			local g = tonumber(hex:sub(3, 4), 16)
			local b = tonumber(hex:sub(5, 6), 16)
			if r and g and b then return Color3.fromRGB(r, g, b) end
		end
	end
	return nil
end

